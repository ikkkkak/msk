              overflow: "hidden",
              pointerEvents: activeTab === "sell" ? "auto" : "none"
            }}
          >
            <MapFloatingActionButton
              actions={[
                {
                  title: t("fab.addPropertyForRent", "Add Property for Rent"),
                  icon: <House size={24} color="#222222" weight="fill" />,
                  onPress: () => {
                    (navigation as any).navigate("AddProperty");
                  },
                  color: ""
                },
                {
                  title: t("fab.addPropertyForSale", "Add Property for Sale"),
                  icon: <ShoppingBag size={24} color="#222222" weight="fill" />,
                  onPress: () => {
                    (navigation as any).navigate("CreatePropertySale");
                  },
                  color: ""
                },
                {
                  title: t("fab.addLandForRent", "Add Land for Rent"),
                  icon: <MapPin size={24} color="#222222" weight="fill" />,
                  onPress: () => {
                    (navigation as any).navigate("CreateLandmark");
                  },
                  color: ""
                }
              ]}
              onMapPress={() => {
                Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light).catch(
                  () => {}
                );
                sellSheetProgrammaticChangeRef.current = true;
                sellSheetRef.current?.snapToIndex(0);
              }}
              sheetAnimatedIndex={sellAnimatedIndex}
            />
          </View>

          {/* Share Sheet Modal */}
          <ShareSheet
            visible={shareSheetVisible}
            onClose={() => setShareSheetVisible(false)}
            property={selectedProperty}
          />

          {/* Property Detail Card moved to end of render to appear on top of sheet */}
        </View>

        {/* Auto-show NotificationPermissionScreen on app mount */}
        <NotificationPermissionAutoShow />

        {/* Floating Video Window - Bottom Right, Above FAB - Always rendered, hidden when inactive */}
        {activeTab === "properties" ? (
          <FloatingVideoWindow sheetIndex={propertiesSheetIndex} />
        ) : null}

        {/* Property Detail Card - RENDERED LAST to appear on top of all sheets */}
        <PropertyDetailCard
          property={cardProperty}
          visible={cardVisible}
          onClose={handleDismissPropertyCard}
          onCardPress={() => {
            // Get property ID
            const pid =
              cardProperty?.id ??
              cardProperty?.ID ??
              cardProperty?.property_id ??
              selectedPropertyId;

            if (!pid) return;

            // OPTIMIZED: Clean navigation - dismiss card first, then navigate
            // Platform-specific timing for smooth transition
            const navDelay = Platform.OS === "android" ? 50 : 150;

            handleDismissPropertyCard?.({ force: true });

            setTimeout(() => {
              navigation.navigate("PropertySaleDetails", {
                propertyId: Number(pid)
              } as any);
            }, navDelay);
          }}
        />
      </>
    );
  } catch (error: any) {
    crashReporting.logError(error, {
      phase: "render",
      screen: "SearchScreen"
    });
    // Return a fallback UI
    return (
      <View
        style={{
          flex: 1,
          backgroundColor: "#FFFFFF",
          justifyContent: "center",
          alignItems: "center",
          padding: 20
        }}
      >
        <Text
          style={{
            fontSize: 18,
            fontWeight: "600",
            color: "#DC2626",
            marginBottom: 12
          }}
        >
          ⚠️ Error rendering SearchScreen
        </Text>
        <Text style={{ fontSize: 14, color: "#6B7280", textAlign: "center" }}>
          Please restart the app
        </Text>
      </View>
    );
  }
};

