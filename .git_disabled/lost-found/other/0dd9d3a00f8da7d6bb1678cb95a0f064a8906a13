      yearBuilt = "any",
      location = "all",
      city_id,
      zone_id
    } = filters;

    const minPrice = priceRange[0] ?? 0;
    const maxPrice = priceRange[1] ?? 50000000;
    const hasYearBuiltFilter =
      yearBuilt &&
      String(yearBuilt).trim() !== "" &&
      String(yearBuilt).trim() !== "any";
    const yearBuiltNum = hasYearBuiltFilter
      ? parseInt(String(yearBuilt).trim(), 10)
      : null;
    const hasLocationFilter = location !== "all";
    const locationLower = hasLocationFilter ? location.toLowerCase() : "";

    // PERFORMANCE: Single-pass filter with optimized predicate
    const filtered = normalizedSaleItems.filter((property: any) => {
      // Property type check
      if (propertyType !== "all" && property.property_type !== propertyType) {
        return false;
      }

      // Price range check
      const price = property.listing_price ?? property.price ?? 0;
      if (minPrice > 0 && price < minPrice) return false;
      if (maxPrice < 50000000 && price > maxPrice) return false;

      // Bedrooms check
      if (bedrooms > 0 && Number(property.bedrooms ?? 0) < bedrooms) {
        return false;
      }

      // Bathrooms check
      if (bathrooms > 0 && Number(property.bathrooms ?? 0) < bathrooms) {
        return false;
      }

      // Year built check (with validation)
      if (
        hasYearBuiltFilter &&
        yearBuiltNum !== null &&
        !isNaN(yearBuiltNum) &&
        yearBuiltNum > 0
      ) {
        const propYear = Number(property.year_built ?? property.YearBuilt ?? 0);
        if (!isFinite(propYear) || propYear <= 0 || propYear < yearBuiltNum) {
          return false;
        }
      }

      // City ID check
      if (
        city_id &&
        Number(property.city_id ?? property.CityID ?? 0) !== Number(city_id)
      ) {
        return false;
      }

      // Zone ID check
      if (
        zone_id &&
        Number(property.zone_id ?? property.ZoneID ?? 0) !== Number(zone_id)
      ) {
        return false;
      }

      // Location check (case-insensitive substring match)
      if (hasLocationFilter && property.city) {
        if (!property.city.toLowerCase().includes(locationLower)) {
          return false;
        }
      }

      return true;
    });

    return {
      data: filtered,
      isLoading: false,
      error: publicPropertySales.error
