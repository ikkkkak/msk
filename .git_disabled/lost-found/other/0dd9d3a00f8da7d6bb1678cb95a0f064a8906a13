                          sellSheetProgrammaticChangeRef.current = true;
                          // Use setTimeout to prevent Reanimated warning
                          setTimeout(() => {
                            sellSheetRef.current?.snapToIndex(0);
                          }, 0);
                        }
                        return; // Exit immediately - card is showing, sheet is locked
                      }

                      // CRITICAL FIX #2: Ignore onChange events during programmatic changes
                      if (sellSheetProgrammaticChangeRef.current) {
                        setSellSheetIndex(index);
                        sellSheetProgrammaticChangeRef.current = false;
                        return; // Exit early - we're controlling this programmatically
                      }

                      setSellSheetIndex(index);

                      // CRITICAL: If card is NOT visible, prevent user from dragging to index 0 (1%)
                      if (!cardVisible && index === 0) {
                        sellSheetProgrammaticChangeRef.current = true;
                        setTimeout(() => {
                          if (sellSheetRef.current?.snapToIndex) {
                            sellSheetRef.current.snapToIndex(1);
