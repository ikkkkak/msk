                  onPress: () => {
                    (navigation as any).navigate("CreateLandmark");
                  },
                  color: ""
                }
              ]}
              onMapPress={() => {
                Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light).catch(
                  () => {}
