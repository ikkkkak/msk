                console.log(
                  "📍 Properties FAB onMapPress - NOT collapsing sheet to prevent blocking card"
                );
                // DO NOT snap properties sheet to 0 here - it prevents card from showing
                // propertiesSheetRef.current?.snapToIndex(0);
