// Move in-component hook usage for OfferInsights OUTSIDE the main render/component tree!
const useOfferInsights = (propertyId: number) => {
  const [selectedView, setSelectedView] = useState<"lowest" | "highest" | null>(
    null
  );
  const { t } = useTranslation();
  const { data: insights } = useQuery({
    queryKey: ["offer-insights", propertyId],
    queryFn: async () => {
      const res = await axios.get(
        `${endpoints.propertySales}/${propertyId}/offer-insights`
      );
      return res.data;
    },
    enabled: !!propertyId
  });
  return { selectedView, setSelectedView, insights, t };
};

const OfferInsights: React.FC<{ propertyId: number }> = ({ propertyId }) => {
  const { selectedView, setSelectedView, insights, t } =
    useOfferInsights(propertyId);
  if (!insights?.offers) return null;
  const o = insights.offers;

  const getDisplayPrice = () => {
    if (selectedView === "lowest") return o.lowest;
    if (selectedView === "highest") return o.highest;
    return o.average;
  };
  const getDisplayLabel = () => {
    if (selectedView === "lowest") return t("sale.lowestOffer");
    if (selectedView === "highest") return t("sale.highestOffer");
    return t("sale.averageOffer");
  };
  return (
    <View style={styles.section}>
      <Text style={styles.sectionTitle}>{t("sale.offerInsights")}</Text>
      {/* Main Price Display */}
      <View style={styles.mainPriceContainer}>
        <Text style={styles.mainPriceLabel}>{getDisplayLabel()}</Text>
        <Text style={styles.mainPriceValue}>
          MRU {Number(getDisplayPrice()).toLocaleString()}
        </Text>
      </View>
      {/* Clickable Options */}
      <View style={styles.insightOptions}>
        <TouchableOpacity
          style={[
            styles.insightOption,
            selectedView === "lowest" && styles.insightOptionSelected
          ]}
          onPress={() =>
            setSelectedView(selectedView === "lowest" ? null : "lowest")
          }
        >
          <Text
            style={[
              styles.insightOptionText,
              selectedView === "lowest" && styles.insightOptionTextSelected
            ]}
          >
            {t("sale.lowest")}
          </Text>
        </TouchableOpacity>
        <TouchableOpacity
          style={[
            styles.insightOption,
            selectedView === "highest" && styles.insightOptionSelected
          ]}
          onPress={() =>
            setSelectedView(selectedView === "highest" ? null : "highest")
          }
        >
          <Text
            style={[
              styles.insightOptionText,
              selectedView === "highest" && styles.insightOptionTextSelected
            ]}
          >
            {t("sale.highest")}
          </Text>
        </TouchableOpacity>
      </View>
      <Text style={styles.insightNote}>
        {t("sale.offerNote", { count: o.count })}
      </Text>
    </View>
  );
};

