                      t("auth.loginToContinue", "Please log in to continue")
                    );
                    return;
                  }
                  if (!targetOrgId) {
                    Alert.alert(
                      t("common.error"),
                      "Unable to identify the organization to block."
                    );
                    return;
                  }
                  await api.post(`/organization/${targetOrgId}/block`);
                  queryClient.invalidateQueries(["public-property-sales"]);
                  queryClient.invalidateQueries(["organization-properties"]);
                  setToast({
                    message: t(
                      "settings.blockedContentDetails.userBlocked",
                      "This organization has been blocked."
                    ) as string,
                    type: "success"
                  });
                  setTimeout(() => navigation.goBack(), 350);
                } catch (e) {
                  setToast({
                    message: t(
                      "settings.blockedContentDetails.unblockFailed",
                      "Failed to block organization."
                    ) as string,
                    type: "error"
                  });
                } finally {
                  setShowBlockModal(false);
                }
              }}
