/**
 * Admin Crash Logs Screen
 * Professional interface for viewing and managing crash logs
 */

import React, { useState, useEffect } from "react";
import {
  View,
  Text,
  StyleSheet,
  ScrollView,
  TouchableOpacity,
  RefreshControl,
  ActivityIndicator,
  Modal,
  Platform
} from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";
import { MaterialIcons } from "@expo/vector-icons";
import { useNavigation } from "@react-navigation/native";
import { useQuery, useQueryClient } from "react-query";
import axios from "axios";
import { endpoints } from "../constants";
import { useUser } from "../hooks/useUser";
import { api } from "../services/api";

interface CrashLog {
  id: number;
  created_at: string;
  error: string;
  stack?: string;
  component_stack?: string;
  phase: string;
  screen: string;
  context_parsed?: Record<string, any>;
  platform: string;
  os_version: string;
  device_model: string;
  app_version: string;
  user_id?: number;
  user?: {
    id: number;
    email?: string;
    username?: string;
  };
  is_resolved: boolean;
  resolved_at?: string;
  resolved_by?: number;
  notes?: string;
  is_fatal: boolean;
  crash_type: string;
}

interface CrashLogStats {
  total: number;
  unresolved: number;
  fatal: number;
  by_platform: Record<string, number>;
  by_screen: Record<string, number>;
  by_crash_type: Record<string, number>;
  last_24_hours: number;
  last_7_days: number;
  last_30_days: number;
}

export const AdminCrashLogsScreen = () => {
  const navigation = useNavigation();
  const { user } = useUser();
  const queryClient = useQueryClient();
  const [selectedLog, setSelectedLog] = useState<CrashLog | null>(null);
  const [modalVisible, setModalVisible] = useState(false);
  const [filter, setFilter] = useState<"all" | "unresolved" | "fatal">("all");
  const [platformFilter, setPlatformFilter] = useState<string>("");
  const [screenFilter, setScreenFilter] = useState<string>("");
  const [page, setPage] = useState(1);
  const [searchQuery, setSearchQuery] = useState("");

  // Fetch crash logs
  const {
    data: logsData,
    isLoading,
    refetch,
    isRefetching
  } = useQuery(
    ["crashLogs", filter, platformFilter, screenFilter, page, searchQuery],
    async () => {
      const params = new URLSearchParams();
      params.set("page", page.toString());
      params.set("limit", "20");
      if (filter === "unresolved") params.set("resolved", "false");
      if (filter === "fatal") {
        // Note: Backend doesn't have fatal filter yet, we'll filter client-side
      }
      if (platformFilter) params.set("platform", platformFilter);
      if (screenFilter) params.set("screen", screenFilter);
      if (searchQuery) params.set("search", searchQuery);

      const response = await api.get(
        `${endpoints.adminCrashLogs}?${params.toString()}`
      );
      return response.data;
    },
    {
      enabled: !!user && (user.role === "admin" || user.role === "super_admin"),
      refetchInterval: 30000 // Refetch every 30 seconds
    }
  );

  // Fetch stats
  const { data: statsData } = useQuery(
    ["crashLogStats"],
    async () => {
      const response = await api.get(`${endpoints.adminCrashLogs}/stats`);
      return response.data;
    },
    {
      enabled: !!user && (user.role === "admin" || user.role === "super_admin"),
      refetchInterval: 60000 // Refetch every minute
    }
  );

  const stats: CrashLogStats | null = statsData?.data || null;
  const crashLogs: CrashLog[] = logsData?.data || [];
  const pagination = logsData?.pagination || {
    page: 1,
    limit: 20,
    total: 0,
    pages: 1
  };

  const handleMarkResolved = async (
    logId: number,
    resolved: boolean,
    notes?: string
  ) => {
    try {
      await api.patch(`${endpoints.adminCrashLogs}/${logId}`, {
        is_resolved: resolved,
        notes: notes || ""
      });
      queryClient.invalidateQueries(["crashLogs"]);
      queryClient.invalidateQueries(["crashLogStats"]);
      setModalVisible(false);
      setSelectedLog(null);
    } catch (error: any) {
      console.error("Failed to update crash log:", error);
      alert("Failed to update crash log");
    }
  };

  const formatDate = (dateString: string) => {
    const date = new Date(dateString);
    return date.toLocaleString();
  };

  const getCrashTypeColor = (type: string) => {
    switch (type) {
      case "unhandledError":
        return "#DC2626";
      case "unhandledPromiseRejection":
        return "#F59E0B";
      case "componentError":
        return "#EF4444";
      case "apiError":
        return "#3B82F6";
      default:
        return "#6B7280";
    }
  };

  const getPlatformIcon = (platform: string) => {
    return platform === "ios" ? "phone-iphone" : "phone-android";
  };

  if (!user || (user.role !== "admin" && user.role !== "super_admin")) {
    return (
      <SafeAreaView style={styles.container}>
        <View style={styles.unauthorizedContainer}>
          <MaterialIcons name="lock" size={48} color="#DC2626" />
          <Text style={styles.unauthorizedText}>Unauthorized</Text>
          <Text style={styles.unauthorizedSubtext}>Admin access required</Text>
        </View>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.container} edges={["top"]}>
      {/* Header */}
      <View style={styles.header}>
        <TouchableOpacity
          onPress={() => navigation.goBack()}
          style={styles.backButton}
        >
          <MaterialIcons name="arrow-back" size={24} color="#111827" />
        </TouchableOpacity>
        <Text style={styles.headerTitle}>Crash Logs</Text>
        <View style={styles.headerRight} />
      </View>

      {/* Stats Cards */}
      {stats && (
        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          style={styles.statsContainer}
          contentContainerStyle={styles.statsContent}
        >
          <View style={styles.statCard}>
            <Text style={styles.statValue}>{stats.total}</Text>
            <Text style={styles.statLabel}>Total Crashes</Text>
          </View>
          <View style={[styles.statCard, styles.statCardUnresolved]}>
            <Text style={[styles.statValue, styles.statValueUnresolved]}>
              {stats.unresolved}
            </Text>
            <Text style={styles.statLabel}>Unresolved</Text>
          </View>
          <View style={[styles.statCard, styles.statCardFatal]}>
            <Text style={[styles.statValue, styles.statValueFatal]}>
              {stats.fatal}
            </Text>
            <Text style={styles.statLabel}>Fatal</Text>
          </View>
          <View style={styles.statCard}>
            <Text style={styles.statValue}>{stats.last_24_hours}</Text>
            <Text style={styles.statLabel}>Last 24h</Text>
          </View>
          <View style={styles.statCard}>
            <Text style={styles.statValue}>{stats.last_7_days}</Text>
            <Text style={styles.statLabel}>Last 7d</Text>
          </View>
        </ScrollView>
      )}

      {/* Filters */}
      <View style={styles.filtersContainer}>
        <ScrollView horizontal showsHorizontalScrollIndicator={false}>
          <TouchableOpacity
            style={[
              styles.filterChip,
              filter === "all" && styles.filterChipActive
            ]}
            onPress={() => setFilter("all")}
          >
            <Text
              style={[
                styles.filterChipText,
                filter === "all" && styles.filterChipTextActive
              ]}
            >
              All
            </Text>
          </TouchableOpacity>
          <TouchableOpacity
            style={[
              styles.filterChip,
              filter === "unresolved" && styles.filterChipActive
            ]}
            onPress={() => setFilter("unresolved")}
          >
            <Text
              style={[
                styles.filterChipText,
                filter === "unresolved" && styles.filterChipTextActive
              ]}
            >
              Unresolved
            </Text>
          </TouchableOpacity>
          <TouchableOpacity
            style={[
              styles.filterChip,
              filter === "fatal" && styles.filterChipActive
            ]}
            onPress={() => setFilter("fatal")}
          >
            <Text
              style={[
                styles.filterChipText,
                filter === "fatal" && styles.filterChipTextActive
              ]}
            >
              Fatal
            </Text>
          </TouchableOpacity>
          {stats?.by_platform &&
            Object.keys(stats.by_platform).map((platform) => (
              <TouchableOpacity
                key={platform}
                style={[
                  styles.filterChip,
                  platformFilter === platform && styles.filterChipActive
                ]}
                onPress={() =>
                  setPlatformFilter(platformFilter === platform ? "" : platform)
                }
              >
                <MaterialIcons
                  name={getPlatformIcon(platform)}
                  size={16}
                  color={platformFilter === platform ? "#FFFFFF" : "#6B7280"}
                />
                <Text
                  style={[
                    styles.filterChipText,
                    platformFilter === platform && styles.filterChipTextActive
                  ]}
                >
                  {platform}
                </Text>
              </TouchableOpacity>
            ))}
        </ScrollView>
      </View>

      {/* Crash Logs List */}
      <ScrollView
        style={styles.listContainer}
        refreshControl={
          <RefreshControl refreshing={isRefetching} onRefresh={refetch} />
        }
      >
        {isLoading ? (
          <View style={styles.loadingContainer}>
            <ActivityIndicator size="large" color="#222222" />
          </View>
        ) : crashLogs.length === 0 ? (
          <View style={styles.emptyContainer}>
            <MaterialIcons name="bug-report" size={64} color="#D1D5DB" />
            <Text style={styles.emptyText}>No crash logs found</Text>
          </View>
        ) : (
          crashLogs
            .filter((log) => {
              if (filter === "fatal" && !log.is_fatal) return false;
              return true;
            })
            .map((log) => (
              <TouchableOpacity
                key={log.id}
                style={[
                  styles.logCard,
                  log.is_resolved && styles.logCardResolved,
                  log.is_fatal && styles.logCardFatal
                ]}
                onPress={() => {
                  setSelectedLog(log);
                  setModalVisible(true);
                }}
              >
                <View style={styles.logHeader}>
                  <View style={styles.logHeaderLeft}>
                    <MaterialIcons
                      name={getPlatformIcon(log.platform)}
                      size={20}
                      color={log.is_fatal ? "#DC2626" : "#6B7280"}
                    />
                    <Text style={styles.logScreen}>
                      {log.screen || "Unknown"}
                    </Text>
                    {log.is_fatal && (
                      <View style={styles.fatalBadge}>
                        <Text style={styles.fatalBadgeText}>FATAL</Text>
                      </View>
                    )}
                    {log.is_resolved && (
                      <View style={styles.resolvedBadge}>
                        <MaterialIcons
                          name="check-circle"
                          size={14}
                          color="#10B981"
                        />
                        <Text style={styles.resolvedBadgeText}>Resolved</Text>
                      </View>
                    )}
                  </View>
                  <Text style={styles.logDate}>
                    {formatDate(log.created_at)}
                  </Text>
                </View>

                <Text style={styles.logError} numberOfLines={2}>
                  {log.error}
                </Text>

                <View style={styles.logMeta}>
                  <View style={styles.logMetaItem}>
                    <MaterialIcons name="category" size={14} color="#9CA3AF" />
                    <Text style={styles.logMetaText}>{log.phase}</Text>
                  </View>
                  <View style={styles.logMetaItem}>
                    <View
                      style={[
                        styles.crashTypeDot,
                        { backgroundColor: getCrashTypeColor(log.crash_type) }
                      ]}
                    />
                    <Text style={styles.logMetaText}>{log.crash_type}</Text>
                  </View>
                  <View style={styles.logMetaItem}>
                    <MaterialIcons
                      name="phone-android"
                      size={14}
                      color="#9CA3AF"
                    />
                    <Text style={styles.logMetaText}>
                      {log.device_model} ({log.os_version})
                    </Text>
                  </View>
                  <View style={styles.logMetaItem}>
                    <MaterialIcons name="info" size={14} color="#9CA3AF" />
                    <Text style={styles.logMetaText}>v{log.app_version}</Text>
                  </View>
                </View>

                {log.user && (
                  <View style={styles.logUser}>
                    <MaterialIcons name="person" size={14} color="#9CA3AF" />
                    <Text style={styles.logUserText}>
                      {log.user.email ||
                        log.user.username ||
                        `User #${log.user.id}`}
                    </Text>
                  </View>
                )}
              </TouchableOpacity>
            ))
        )}

        {/* Pagination */}
        {pagination.pages > 1 && (
          <View style={styles.pagination}>
            <TouchableOpacity
              style={[
                styles.paginationButton,
                page === 1 && styles.paginationButtonDisabled
              ]}
              onPress={() => setPage(page - 1)}
              disabled={page === 1}
            >
              <MaterialIcons
                name="chevron-left"
                size={20}
                color={page === 1 ? "#D1D5DB" : "#111827"}
              />
            </TouchableOpacity>
            <Text style={styles.paginationText}>
              Page {page} of {pagination.pages}
            </Text>
            <TouchableOpacity
              style={[
                styles.paginationButton,
                page === pagination.pages && styles.paginationButtonDisabled
              ]}
              onPress={() => setPage(page + 1)}
              disabled={page === pagination.pages}
            >
              <MaterialIcons
                name="chevron-right"
                size={20}
                color={page === pagination.pages ? "#D1D5DB" : "#111827"}
              />
            </TouchableOpacity>
          </View>
        )}
      </ScrollView>

      {/* Detail Modal */}
      <Modal
        visible={modalVisible}
        animationType="slide"
        presentationStyle="pageSheet"
        onRequestClose={() => {
          setModalVisible(false);
          setSelectedLog(null);
        }}
      >
        <SafeAreaView style={styles.modalContainer} edges={["top"]}>
          <View style={styles.modalHeader}>
            <Text style={styles.modalTitle}>Crash Log Details</Text>
            <TouchableOpacity
              onPress={() => {
                setModalVisible(false);
                setSelectedLog(null);
              }}
              style={styles.modalCloseButton}
            >
              <MaterialIcons name="close" size={24} color="#111827" />
            </TouchableOpacity>
          </View>

          {selectedLog && (
            <ScrollView style={styles.modalContent}>
              {/* Error Message */}
              <View style={styles.detailSection}>
                <Text style={styles.detailLabel}>Error Message</Text>
                <Text style={styles.detailValue}>{selectedLog.error}</Text>
              </View>

              {/* Stack Trace */}
              {selectedLog.stack && (
                <View style={styles.detailSection}>
                  <Text style={styles.detailLabel}>Stack Trace</Text>
                  <ScrollView
                    horizontal
                    style={styles.stackTraceContainer}
                    contentContainerStyle={styles.stackTraceContent}
                  >
                    <Text style={styles.stackTraceText}>
                      {selectedLog.stack}
                    </Text>
                  </ScrollView>
                </View>
              )}

              {/* Component Stack */}
              {selectedLog.component_stack && (
                <View style={styles.detailSection}>
                  <Text style={styles.detailLabel}>Component Stack</Text>
                  <ScrollView
                    horizontal
                    style={styles.stackTraceContainer}
                    contentContainerStyle={styles.stackTraceContent}
                  >
                    <Text style={styles.stackTraceText}>
                      {selectedLog.component_stack}
                    </Text>
                  </ScrollView>
                </View>
              )}

              {/* Context */}
              {selectedLog.context_parsed && (
                <View style={styles.detailSection}>
                  <Text style={styles.detailLabel}>Context</Text>
                  <Text style={styles.detailValue}>
                    {JSON.stringify(selectedLog.context_parsed, null, 2)}
                  </Text>
                </View>
              )}

              {/* Device Info */}
              <View style={styles.detailSection}>
                <Text style={styles.detailLabel}>Device Information</Text>
                <View style={styles.detailRow}>
                  <Text style={styles.detailRowLabel}>Platform:</Text>
                  <Text style={styles.detailRowValue}>
                    {selectedLog.platform}
                  </Text>
                </View>
                <View style={styles.detailRow}>
                  <Text style={styles.detailRowLabel}>OS Version:</Text>
                  <Text style={styles.detailRowValue}>
                    {selectedLog.os_version}
                  </Text>
                </View>
                <View style={styles.detailRow}>
                  <Text style={styles.detailRowLabel}>Device Model:</Text>
                  <Text style={styles.detailRowValue}>
                    {selectedLog.device_model}
                  </Text>
                </View>
                <View style={styles.detailRow}>
                  <Text style={styles.detailRowLabel}>App Version:</Text>
                  <Text style={styles.detailRowValue}>
                    {selectedLog.app_version}
                  </Text>
                </View>
              </View>

              {/* Crash Info */}
              <View style={styles.detailSection}>
                <Text style={styles.detailLabel}>Crash Information</Text>
                <View style={styles.detailRow}>
                  <Text style={styles.detailRowLabel}>Screen:</Text>
                  <Text style={styles.detailRowValue}>
                    {selectedLog.screen}
                  </Text>
                </View>
                <View style={styles.detailRow}>
                  <Text style={styles.detailRowLabel}>Phase:</Text>
                  <Text style={styles.detailRowValue}>{selectedLog.phase}</Text>
                </View>
                <View style={styles.detailRow}>
                  <Text style={styles.detailRowLabel}>Crash Type:</Text>
                  <Text style={styles.detailRowValue}>
                    {selectedLog.crash_type}
                  </Text>
                </View>
                <View style={styles.detailRow}>
                  <Text style={styles.detailRowLabel}>Is Fatal:</Text>
                  <Text
                    style={[
                      styles.detailRowValue,
                      selectedLog.is_fatal && styles.detailRowValueFatal
                    ]}
                  >
                    {selectedLog.is_fatal ? "Yes" : "No"}
                  </Text>
                </View>
                <View style={styles.detailRow}>
                  <Text style={styles.detailRowLabel}>Created At:</Text>
                  <Text style={styles.detailRowValue}>
                    {formatDate(selectedLog.created_at)}
                  </Text>
                </View>
              </View>

              {/* User Info */}
              {selectedLog.user && (
                <View style={styles.detailSection}>
                  <Text style={styles.detailLabel}>User Information</Text>
                  <View style={styles.detailRow}>
                    <Text style={styles.detailRowLabel}>User ID:</Text>
                    <Text style={styles.detailRowValue}>
                      {selectedLog.user.id}
                    </Text>
                  </View>
                  {selectedLog.user.email && (
                    <View style={styles.detailRow}>
                      <Text style={styles.detailRowLabel}>Email:</Text>
                      <Text style={styles.detailRowValue}>
                        {selectedLog.user.email}
                      </Text>
                    </View>
                  )}
                </View>
              )}

              {/* Resolution Status */}
              {selectedLog.is_resolved && (
                <View style={styles.detailSection}>
                  <Text style={styles.detailLabel}>Resolution</Text>
                  <View style={styles.detailRow}>
                    <Text style={styles.detailRowLabel}>Resolved At:</Text>
                    <Text style={styles.detailRowValue}>
                      {selectedLog.resolved_at
                        ? formatDate(selectedLog.resolved_at)
                        : "N/A"}
                    </Text>
                  </View>
                  {selectedLog.notes && (
                    <View style={styles.detailRow}>
                      <Text style={styles.detailRowLabel}>Notes:</Text>
                      <Text style={styles.detailRowValue}>
                        {selectedLog.notes}
                      </Text>
                    </View>
                  )}
                </View>
              )}

              {/* Actions */}
              <View style={styles.modalActions}>
                {!selectedLog.is_resolved ? (
                  <TouchableOpacity
                    style={styles.resolveButton}
                    onPress={() => handleMarkResolved(selectedLog.id, true)}
                  >
                    <MaterialIcons
                      name="check-circle"
                      size={20}
                      color="#FFFFFF"
                    />
                    <Text style={styles.resolveButtonText}>
                      Mark as Resolved
                    </Text>
                  </TouchableOpacity>
                ) : (
                  <TouchableOpacity
                    style={styles.unresolveButton}
                    onPress={() => handleMarkResolved(selectedLog.id, false)}
                  >
                    <MaterialIcons name="cancel" size={20} color="#FFFFFF" />
                    <Text style={styles.unresolveButtonText}>
                      Mark as Unresolved
                    </Text>
                  </TouchableOpacity>
                )}
              </View>
            </ScrollView>
          )}
        </SafeAreaView>
      </Modal>
    </SafeAreaView>
  );
};

