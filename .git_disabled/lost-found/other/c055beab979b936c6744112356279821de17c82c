const VideoFeedSection: React.FC = () => {
  const navigation = useNavigation();
  const { t } = useTranslation();
  const { data: videos, isLoading } = useVideoFeedQuery(1, 10);
  const [currentVideoIndex, setCurrentVideoIndex] = useState(0);
  const [isPlaying, setIsPlaying] = useState(true);
  const scrollViewRef = useRef<ScrollView>(null);

  // Auto-scroll videos
  useEffect(() => {
    if (!videos || videos.length === 0) return;

    const interval = setInterval(() => {
      if (isPlaying) {
        setCurrentVideoIndex((prev) => (prev + 1) % videos.length);
      }
    }, 5000); // Change video every 5 seconds

    return () => clearInterval(interval);
  }, [videos, isPlaying]);

  // Auto-scroll to current video
  useEffect(() => {
    if (scrollViewRef.current && videos && videos.length > 0) {
      scrollViewRef.current.scrollTo({
        x: currentVideoIndex * (width * 0.6 + 12),
        animated: true
      });
    }
  }, [currentVideoIndex]);

  const handleViewMore = () => {
    (navigation as any).navigate("Videos");
  };

  const togglePlayPause = () => {
    setIsPlaying(!isPlaying);
  };

  if (isLoading) {
    return (
      <View style={styles.videoSection}>
        <View style={styles.videoSectionHeader}>
          <Text style={styles.videoSectionTitle}>{t("videos.discover")}</Text>
        </View>
        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          style={styles.videoScroll}
        >
          {[1, 2, 3].map((index) => (
            <View key={index} style={styles.videoCardSkeleton}>
              <View style={styles.videoSkeleton} />
              <View style={styles.videoInfoSkeleton}>
                <View style={styles.videoTitleSkeleton} />
                <View style={styles.videoSubtitleSkeleton} />
              </View>
            </View>
          ))}
        </ScrollView>
      </View>
    );
  }

  if (!videos || videos.length === 0) {
    return null;
  }

  return (
    <View style={styles.videoSection}>
      <View style={styles.videoSectionHeader}>
        <Text style={styles.videoSectionTitle}>{t("videos.discover")}</Text>
        <TouchableOpacity
          style={styles.viewMoreButton}
          onPress={handleViewMore}
        >
          <Text style={styles.viewMoreText}>{t("common.viewMore")}</Text>
          <MaterialIcons name="arrow-forward-ios" size={13} color="#222222" />
        </TouchableOpacity>
      </View>

      <ScrollView
        ref={scrollViewRef}
        horizontal
        showsHorizontalScrollIndicator={false}
        style={styles.videoScroll}
        contentContainerStyle={styles.videoScrollContent}
        decelerationRate="fast"
        snapToInterval={width * 0.6 + 12}
        snapToAlignment="start"
      >
        {videos.slice(0, 10).map((video: any, index: number) => (
          <VideoCard
            key={video.id || video.ID}
            video={video}
            isActive={index === currentVideoIndex}
            isPlaying={isPlaying && index === currentVideoIndex}
            onPress={() =>
              (navigation as any).navigate("VideoFeed", {
                initialVideoId: video.id || video.ID
              })
            }
            onTogglePlay={togglePlayPause}
          />
        ))}
      </ScrollView>
    </View>
  );
};

interface VideoCardProps {
  video: any;
  isActive: boolean;
  isPlaying: boolean;
  onPress: () => void;
  onTogglePlay: () => void;
}

const VideoCard: React.FC<VideoCardProps> = ({
  video,
  isActive,
  isPlaying,
  onPress,
  onTogglePlay
}) => {
  const { t } = useTranslation();
  const videoRef = useRef<Video>(null);

  const videoUrl =
    video.videoURL || video.videoUrl || video.VideoURL || video.url;
  const videoThumbnail =
    video.thumbnailURL ||
    video.thumbnail ||
    video.Thumbnail ||
    video.previewImage;
  const videoTitle = video.caption || video.title || video.Title;
  const propertyTitleRaw =
    video.property?.title || video.Property?.Title || "Beautiful Property";
  const propertyPrice =
    video.property?.nightlyPrice || video.Property?.NightlyPrice || 0;

  // Title already localized by backend
  const propertyTitle = propertyTitleRaw;
  const isVideoTitleTranslated = false;

  const formatPrice = (price: number) => {
    return new Intl.NumberFormat("fr-MR", {
      style: "currency",
      currency: "MRU",
      minimumFractionDigits: 0
    }).format(price);
  };

  // Handle video playback
  useEffect(() => {
    if (videoRef.current) {
      if (isPlaying && isActive) {
        videoRef.current.playAsync();
      } else {
        videoRef.current.pauseAsync();
      }
    }
  }, [isPlaying, isActive]);

  return (
    <TouchableOpacity
      style={styles.videoCard}
      onPress={onPress}
      activeOpacity={0.9}
    >
      <View style={styles.videoContainer}>
        {videoUrl ? (
          <Video
            ref={videoRef}
            source={{ uri: videoUrl }}
            style={styles.videoPlayer}
            resizeMode={ResizeMode.COVER}
            shouldPlay={isPlaying && isActive}
            isLooping={true}
            isMuted={true}
            onLoad={() => {
              if (isPlaying && isActive) {
                videoRef.current?.playAsync();
              }
            }}
          />
        ) : videoThumbnail ? (
          <Image
            source={{ uri: videoThumbnail }}
            style={styles.videoThumbnail}
          />
        ) : (
          <View style={styles.videoPlaceholder}>
            <MaterialIcons
              name="play-circle-filled"
              size={48}
              color="#FFFFFF"
            />
          </View>
        )}

        {/* Play/Pause Overlay */}
        <TouchableOpacity
          style={styles.playButton}
          onPress={onTogglePlay}
          activeOpacity={0.8}
        >
          {isPlaying && isActive ? (
            <Pause size={24} color="#FFFFFF" weight="fill" />
          ) : (
            <Play size={24} color="#FFFFFF" weight="fill" />
          )}
        </TouchableOpacity>

        {/* Video Info Overlay */}
        <View style={styles.videoInfoOverlay}>
          <Text style={styles.videoTitle} numberOfLines={2}>
            {videoTitle}
          </Text>
          <View style={{ flexDirection: "row", alignItems: "center", flex: 1 }}>
            <Text
              style={[
                styles.propertyTitle,
                {
                  color: "#FFF"
                }
              ]}
              numberOfLines={1}
            >
              {propertyTitle}
            </Text>
            {isVideoTitleTranslated && (
              <MaterialIcons
                name="translate"
                size={12}
                color="#FFFFFF"
                style={{ marginLeft: 4, opacity: 0.9 }}
              />
            )}
          </View>
          {propertyPrice > 0 && (
            <Text style={styles.propertyPrice}>
              {formatPrice(propertyPrice)} / {t("common.night", "night")}
            </Text>
          )}
        </View>

        {/* Duration Badge */}
        {video.duration && (
          <View style={styles.durationBadge}>
            <Text style={styles.durationText}>{video.duration}</Text>
          </View>
        )}
      </View>
    </TouchableOpacity>
  );
};

interface LocationSectionProps {
  title: string;
  locationKey: string;
  locationName: string;
  criteriaId: number;
  description?: string;
  icon?: string;
  color?: string;
  propertyCount?: number;
  onViewAll: (locationKey: string, locationName: string) => void;
  isFirst?: boolean;
  onToast?: (message: string, type?: "success" | "error" | "info") => void;
}

const LocationSection: React.FC<LocationSectionProps> = ({
  title,
  locationKey,
  locationName,
  criteriaId,
  description,
  icon,
  color,
  propertyCount,
  onViewAll,
  isFirst = false,
  onToast
}) => {
  const { t } = useTranslation();
  // Use the new location discovery API
  const { currentLanguage } = useLanguage();
  const langParam = (currentLanguage || "en").toLowerCase();
  const {
    data: locationData,
    isLoading: locationLoading,
    error: locationError
  } = useLocationProperties(criteriaId, 8, langParam);

  if (locationLoading) {
    return (
      <View style={[styles.section, isFirst && styles.firstSection]}>
        <View style={styles.sectionHeader}>
          <Text style={styles.sectionTitle}>{title}</Text>
        </View>
        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          style={styles.propertiesScroll}
          contentContainerStyle={styles.propertiesScrollContent}
        >
          {[1, 2, 3, 4].map((index) => (
            <SkeletonCard
              key={index}
              isFirst={isFirst && index === 0}
              isLast={index === 3}
              delay={index * 100} // Staggered delay: 0ms, 100ms, 200ms, 300ms
            />
          ))}
        </ScrollView>
      </View>
    );
  }

  if (locationError) {
    return null; // Don't render sections with errors
  }

  // Get properties from location data
  const properties = locationData?.properties || [];

  if (!properties || properties.length === 0) {
    return null; // Don't render empty sections
  }
  return (
    <View style={[styles.section, isFirst && styles.firstSection]}>
      <View style={styles.sectionHeader}>
        <View style={styles.sectionTitleContainer}>
          <Text style={styles.sectionTitle}>{title.toUpperCase()}</Text>
          {propertyCount !== undefined && (
            <Text style={styles.propertyCountText}>
              {propertyCount} {t("common.properties")}
            </Text>
          )}
        </View>
        <TouchableOpacity
          style={styles.viewAllButton}
          onPress={() => onViewAll(locationKey, locationName)}
        >
          <Text style={styles.viewAllText}>{t("common.viewAll")}</Text>
          <MaterialIcons name="arrow-forward-ios" size={13} color="#222222" />
        </TouchableOpacity>
      </View>

      <ScrollView
        horizontal
        showsHorizontalScrollIndicator={false}
        style={styles.propertiesScroll}
        contentContainerStyle={styles.propertiesScrollContent}
        scrollEnabled={true}
        nestedScrollEnabled={true}
        bounces={true}
        alwaysBounceHorizontal={false}
        directionalLockEnabled={true}
      >
        {properties.slice(0, 8).map((property: any, index: number) => (
          <PropertyCard
            key={property.id || property.ID}
            property={property}
            isFirst={index === 0}
            isLast={index === Math.min(properties.length, 8) - 1}
            delay={index * 80} // Staggered delay for smooth appearance
            onToast={onToast}
          />
        ))}
      </ScrollView>
    </View>
  );
};

interface PropertyCardProps {
  property: any;
  locationCriteria?: {
    displayName: string;
    locationKey: string;
    criteriaId: number;
  };
  isFirst?: boolean;
  isLast?: boolean;
  delay?: number;
  onToast?: (message: string, type?: "success" | "error" | "info") => void;
}

const PropertyCard: React.FC<PropertyCardProps> = ({
  property,
  locationCriteria,
  isFirst,
  isLast,
  delay = 0,
  onToast
}) => {
  const navigation = useNavigation();
  const [isLiked, setIsLiked] = useState(false);
  const [showVerificationModal, setShowVerificationModal] = useState(false);
  const [showShareSheet, setShowShareSheet] = useState(false);
  const [currentImageIndex, setCurrentImageIndex] = useState(0);
  const scrollViewRef = useRef<ScrollView>(null);
  const touchStartX = useRef<number>(0);
  const touchStartY = useRef<number>(0);
  const { user, setSavedProperties } = useUser();
  const addToWishlist = useAddToWishlistMutation();
  const removeFromWishlist = useRemoveFromWishlistMutation();
  const { currentLanguage } = useLanguage();
  const langParam = (currentLanguage || "en").toLowerCase();

  const showToastMessage = (
    message: string,
    type: "success" | "error" | "info" = "success"
  ) => {
    if (onToast) onToast(message, type);
  };

  // DISABLE ANIMATIONS ON ANDROID to prevent crashes
  // On Android, start with full opacity and scale to avoid fade-in animations
  const fadeAnim = useRef(new Animated.Value(Platform.OS === 'android' ? 1 : 0)).current;
  const scaleAnim = useRef(new Animated.Value(Platform.OS === 'android' ? 1 : 0.95)).current;

  useEffect(() => {
    // DISABLE ANIMATIONS ON ANDROID to prevent crashes and improve performance
    if (Platform.OS === 'android') {
      // On Android, set final values immediately - no animations
      fadeAnim.setValue(1);
      scaleAnim.setValue(1);
      return;
    }
    
    // iOS: Smooth fade-in animation
    const timer = setTimeout(() => {
      Animated.sequence([
        Animated.parallel([
          Animated.timing(fadeAnim, {
            toValue: 1,
            duration: 400,
            useNativeDriver: true
          }),
          Animated.spring(scaleAnim, {
            toValue: 1.02,
            tension: 100,
            friction: 8,
            useNativeDriver: true
          })
        ]),
        Animated.spring(scaleAnim, {
          toValue: 1,
          tension: 100,
          friction: 8,
          useNativeDriver: true
        })
      ]).start();
    }, delay);

    return () => clearTimeout(timer);
  }, [delay, fadeAnim, scaleAnim]);

  // Keep local liked state in sync with global savedProperties
  useEffect(() => {
    if (!property) return;
    const propertyId = property.id || property.ID;
    const likedNow = !!user?.savedProperties?.includes(propertyId);
    if (likedNow !== isLiked) setIsLiked(likedNow);
  }, [user?.savedProperties, property?.id, property?.ID]);

  const handlePress = () => {
    const propertyId = property.id || property.ID;
    (navigation as any).navigate("PropertyDetails", { propertyID: propertyId });
  };

  const toggleLike = async () => {
    if (isLiked) {
      // If already liked, remove from wishlist
      await handleRemoveFromWishlist();
    } else {
      // If not liked, add to wishlist directly
      await handleAddToWishlist();
    }
  };

  const handleAddToWishlist = async () => {
    if (!property) return;

    const propertyId = property.id || property.ID;

    try {
      await addToWishlist.mutateAsync(propertyId);

      // Update user's saved properties in frontend state
      if (user && !user.savedProperties?.includes(propertyId)) {
        const newSavedProperties = [
          ...(user.savedProperties || []),
          propertyId
        ];
        setSavedProperties(newSavedProperties);
      }

      setIsLiked(true);
      showToastMessage(t("addProperty.toast.wishlist.added"), "success");
    } catch (error) {
      console.error("Error adding to wishlist:", error);
      showToastMessage(
        t("addProperty.toast.wishlist.failedAdd", "Failed to add to wishlist"),
        "error"
      );
    }
  };

  const handleRemoveFromWishlist = async () => {
    if (!property) return;

    const propertyId = property.id || property.ID;

    try {
      await removeFromWishlist.mutateAsync(propertyId);

      // Update user's saved properties in frontend state
      if (user && user.savedProperties?.includes(propertyId)) {
        const newSavedProperties = user.savedProperties.filter(
          (id) => id !== propertyId
        );
        setSavedProperties(newSavedProperties);
      }

      setIsLiked(false);
      showToastMessage(
        t(
          "addProperty.toast.wishlist.removed",
          "Property removed from wishlist"
        ),
        "success"
      );
    } catch (error) {
      console.error("Error removing from wishlist:", error);
      // Still update the UI state even if API call fails
      setIsLiked(false);
      showToastMessage(
        t(
          "addProperty.toast.wishlist.failedRemove",
          "Failed to remove from wishlist"
        ),
        "error"
      );
    }
  };

  const formatPrice = (price: number) => {
    return new Intl.NumberFormat("fr-MR", {
      style: "currency",
      currency: "MRU",
      minimumFractionDigits: 0
    }).format(price);
  };

  const getPropertyTypeText = (type: string) => {
    switch (type) {
      case "entire_place":
        return "Apartment";
      case "private_room":
        return "Private room";
      case "shared_room":
        return "Shared room";
      default:
        return "Place to stay";
    }
  };

  // Handle different property data structures
  const propertyImages =
    property.images ||
    (typeof property.Images === "string" ? JSON.parse(property.Images) : []);
  const propertyPrice = property.nightlyPrice || property.NightlyPrice || 0;
  const propertyRating = property.rating || property.Rating || 0;
  const propertyType =
    property.propertyType || property.PropertyType || "entire_place";
  const propertyCity = property.city || property.City || "Nouakchott";
  const { t } = useTranslation();

  // Use backend-translated fields directly (no frontend translation needed)
  const propertyTitle = property.title || property.Title || "";
  const propertyDescription =
    property.description ||
    property.Description ||
    property.summary ||
    property.Summary ||
    "";

  // Debug: Log title to verify language (remove in production)
  useEffect(() => {
    if (propertyTitle && property.id) {
      console.log(
        `🌐 Property ${property.id || property.ID} title (lang=${langParam}):`,
        propertyTitle
      );
    }
  }, [propertyTitle, property.id, property.ID, langParam]);

  // Handle horizontal scroll for image carousel
  const handleScroll = (event: any) => {
    const scrollPosition = event.nativeEvent.contentOffset.x;
    const imageWidth = width - 40; // Full width minus padding for single column
    const index = Math.round(scrollPosition / imageWidth);
    if (
      index !== currentImageIndex &&
      index >= 0 &&
      index < propertyImages.length
    ) {
      setCurrentImageIndex(index);
    }
  };

  // Reset to first image when property changes
  useEffect(() => {
    setCurrentImageIndex(0);
    if (scrollViewRef.current) {
      scrollViewRef.current.scrollTo({ x: 0, animated: false });
    }
  }, [property.id || property.ID]);

  // Get visible dots based on active index and total photos
  const getVisibleDots = () => {
    const MAX_VISIBLE = 5;
    const totalPhotos = propertyImages.length;

    if (totalPhotos <= MAX_VISIBLE) {
      // Show all dots if 5 or fewer photos
      return propertyImages.map((_: any, index: number) => ({
        index,
        distance: Math.abs(index - currentImageIndex)
      }));
    }

    // Show max 5 dots centered around active index
    // Try to center around active, but adjust if near edges
    const visibleIndices: number[] = [];
    let startOffset = -2;
    let endOffset = 2;

    // Adjust if we're near the start
    if (currentImageIndex < 2) {
      startOffset = -currentImageIndex;
      endOffset = MAX_VISIBLE - currentImageIndex - 1;
    }
    // Adjust if we're near the end
    else if (currentImageIndex >= totalPhotos - 2) {
      startOffset = -(MAX_VISIBLE - (totalPhotos - currentImageIndex));
      endOffset = totalPhotos - currentImageIndex - 1;
    }

    for (let i = startOffset; i <= endOffset; i++) {
      const idx = currentImageIndex + i;
      if (
        idx >= 0 &&
        idx < totalPhotos &&
        visibleIndices.length < MAX_VISIBLE
      ) {
        visibleIndices.push(idx);
      }
    }

    return visibleIndices
      .sort((a, b) => a - b) // Sort by index to ensure correct order
      .map((index) => ({
        index,
        distance: Math.abs(index - currentImageIndex)
      }));
  };

  // Get dot size and opacity based on distance from active
  const getDotStyle = (distance: number) => {
    let size = 4; // smallest
    let opacity = 0.3;
    let color = "#D1D1D1";

    switch (distance) {
      case 0: // active (center)
        size = 8;
        opacity = 1;
        color = "#FFFFFF";
        break;
      case 1: // near
        size = 6;
        opacity = 0.6;
        color = "#D1D1D1";
        break;
      case 2: // far
        size = 4;
        opacity = 0.3;
        color = "#D1D1D1";
        break;
      default:
        // Hidden (beyond 2 steps)
        return { display: "none" as const };
    }

    return {
      width: size,
      height: size,
      borderRadius: size / 2,
      backgroundColor: color,
      opacity
    };
  };

  // Animated values for dots (spring animation) - memoized per dot index
  const dotScaleAnims = useRef<{ [key: number]: Animated.Value }>({}).current;

  // Initialize and update dot animations
  useEffect(() => {
    const visibleDots = getVisibleDots();

    // Initialize animated values for all possible dots
    propertyImages.forEach((_: any, index: number) => {
      if (!dotScaleAnims[index]) {
        const distance = Math.abs(index - currentImageIndex);
        const scale = distance === 0 ? 1 : distance === 1 ? 0.75 : 0.5;
        dotScaleAnims[index] = new Animated.Value(scale);
      }
    });

    // Animate dots when currentImageIndex changes
    visibleDots.forEach(
      ({ index, distance }: { index: number; distance: number }) => {
        const targetScale = distance === 0 ? 1 : distance === 1 ? 0.75 : 0.5;
        if (dotScaleAnims[index]) {
          Animated.spring(dotScaleAnims[index], {
            toValue: targetScale,
            tension: 100,
            friction: 8,
            useNativeDriver: true
          }).start();
        }
      }
    );
  }, [currentImageIndex, propertyImages.length]);

  return (
    <Animated.View
      style={[
        styles.propertyCard,
        isFirst && styles.firstCard,
        isLast && styles.lastCard,
        {
          opacity: fadeAnim,
          transform: [{ scale: scaleAnim }]
        }
      ]}
    >
      <TouchableOpacity
        style={styles.propertyCardTouchable}
        onPress={handlePress}
        activeOpacity={0.9}
        delayPressIn={150}
      >
        <View style={styles.propertyImageContainer}>
          {propertyImages && propertyImages.length > 0 ? (
            <>
              {/* Horizontal Image Carousel */}
              <ScrollView
                ref={scrollViewRef}
                horizontal
                pagingEnabled
                showsHorizontalScrollIndicator={false}
                onScroll={handleScroll}
                scrollEventThrottle={16}
                decelerationRate="fast"
                snapToInterval={width - 40}
                snapToAlignment="start"
                style={styles.imageCarousel}
                contentContainerStyle={[
                  styles.imageCarouselContent,
                  { width: (width - 40) * propertyImages.length } // CRITICAL for Android: Set explicit width
                ]}
                nestedScrollEnabled={Platform.OS === 'android'}
                scrollEnabled={true}
              >
                {propertyImages.map((imageUri: string, index: number) => (
                  <Image
                    key={index}
                    source={{ uri: imageUri }}
                    style={[styles.carouselImage, { width: width - 40 }]} // CRITICAL for Android: Explicit width
                    resizeMode="cover"
                  />
                ))}
              </ScrollView>

              {/* Pagination Dots */}
              {propertyImages.length > 1 && (
                <View style={styles.paginationDotsContainer}>
                  {getVisibleDots().map(
                    ({
                      index,
                      distance
                    }: {
                      index: number;
                      distance: number;
                    }) => {
                      const dotStyle = getDotStyle(distance);
                      if (dotStyle.display === "none") return null;

                      // Ensure animated value exists
                      if (!dotScaleAnims[index]) {
                        const scale =
                          distance === 0 ? 1 : distance === 1 ? 0.75 : 0.5;
                        dotScaleAnims[index] = new Animated.Value(scale);
                      }

                      return (
                        <Animated.View
                          key={index}
                          style={[
                            styles.paginationDot,
                            dotStyle,
                            {
                              transform: [{ scale: dotScaleAnims[index] }]
                            }
                          ]}
                        />
                      );
                    }
                  )}
                </View>
              )}
            </>
          ) : (
            <View style={styles.placeholderImage}>
              <MaterialIcons name="home" size={32} color="#E0E0E0" />
            </View>
          )}

          {/* Heart icon */}
          <TouchableOpacity style={styles.heartButton} onPress={toggleLike}>
            <MaterialIcons
              name={isLiked ? "favorite" : "favorite-border"}
              size={20}
              color={isLiked ? "#FF385C" : "#FFFFFF"}
            />
          </TouchableOpacity>

          {/* Share button */}
          <TouchableOpacity
            style={styles.shareButton}
            onPress={() => setShowShareSheet(true)}
          >
            <Share size={20} color="#FFFFFF" weight="bold" />
          </TouchableOpacity>
        </View>

        <View style={styles.propertyContent}>
          <View style={styles.titleRow}>
            <Text style={styles.propertyTitle} numberOfLines={1}>
              {propertyTitle}
            </Text>
          </View>

          {/* Location Criteria as Detail */}
          {locationCriteria && (
            <View style={styles.locationCriteriaContainer}>
              <MaterialIcons name="location-on" size={16} color="#717171" />
              <Text style={styles.locationCriteriaText}>
                {locationCriteria.displayName}
              </Text>
            </View>
          )}

          <Text style={styles.propertyPrice}>
            {formatPrice(propertyPrice)} 1 {t("common.night")}
          </Text>

          <View
            style={{
              flexDirection: "row",
              alignItems: "center",
              marginTop: 4,
              gap: 12
            }}
          >
            <View style={styles.propertyRating}>
              <MaterialIcons name="star" size={14} color="#222222" />
              <Text style={styles.ratingText}>{propertyRating.toFixed(1)}</Text>
            </View>
            {property.host?.isVerified && (
              <TouchableOpacity
                style={styles.verifiedBadge}
                onPress={() => setShowVerificationModal(true)}
                activeOpacity={0.7}
              >
                <MaterialIcons name="check-circle" size={13} color="#FFFFFF" />
                <Text style={styles.verifiedText}>{t("common.verified")}</Text>
              </TouchableOpacity>
            )}
          </View>
        </View>

        {/* Verification Modal */}
        <Modal
          visible={showVerificationModal}
          transparent={true}
          animationType="none"
          onRequestClose={() => setShowVerificationModal(false)}
        >
          <TouchableOpacity
            style={styles.modalOverlay}
            activeOpacity={1}
            onPress={() => setShowVerificationModal(false)}
          >
            <View style={styles.modalContainer}>
              <View style={styles.modalContent}>
                {/* Large Verification Badge */}
                <View style={styles.largeVerifiedBadge}>
                  <MaterialIcons
                    name="check-circle"
                    size={32}
                    color="#FFFFFF"
                  />
                  <Text style={styles.largeVerifiedText}>Verified Host</Text>
                </View>

                {/* Explanation */}
                <Text style={styles.verificationTitle}>Identity Verified</Text>
                <Text style={styles.verificationDescription}>
                  This host has completed our identity verification process.
                  They've provided government-issued ID and confirmed their
                  identity, giving you extra confidence in your booking.
                </Text>

                {/* Close Button */}
                <TouchableOpacity
                  style={styles.closeButton}
                  onPress={() => setShowVerificationModal(false)}
                >
                  <Text style={styles.closeButtonText}>Got it</Text>
                </TouchableOpacity>
              </View>
            </View>
          </TouchableOpacity>
        </Modal>

        {/* Share Sheet Modal */}
        <ShareSheet
          visible={showShareSheet}
          onClose={() => setShowShareSheet(false)}
          property={property}
        />

        {/* Custom Toast */}
        {/* Toast moved to screen level */}
      </TouchableOpacity>
    </Animated.View>
  );
};

