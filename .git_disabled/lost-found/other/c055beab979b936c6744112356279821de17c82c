interface AirbnbHomeDiscoveryProps {
  onViewAll?: (locationKey: string, locationName: string) => void;
}

export const AirbnbHomeDiscovery: React.FC<AirbnbHomeDiscoveryProps> = ({
  onViewAll
}) => {
  const navigation = useNavigation();
  const [selectedCategory, setSelectedCategory] = useState("homes");
  const [showScrollToTop, setShowScrollToTop] = useState<boolean>(false);
  const scrollViewRef = useRef<ScrollView>(null);
  const lastScrollY = useRef<number>(0);
  const buttonOpacity = useRef(new Animated.Value(0)).current;
  // Screen-level toast
  const [showToast, setShowToast] = useState(false);
  const [toastMessage, setToastMessage] = useState("");
  const [toastType, setToastType] = useState<"success" | "error" | "info">(
    "success"
  );
  const showToastMessage = (
    message: string,
    type: "success" | "error" | "info" = "success"
  ) => {
    setToastMessage(message);
    setToastType(type);
    setShowToast(true);
  };

  // Get location criteria from server
  // Get current language for API requests
  const { currentLanguage } = useLanguage();
  const langParam = (currentLanguage || "en").toLowerCase();

  const {
    data: locationCriteria,
    isLoading: criteriaLoading,
    error: criteriaError
  } = useLocationCriteria(langParam);

  const handleViewAll = (locationKey: string, locationName: string) => {
    if (onViewAll) {
      onViewAll(locationKey, locationName);
    } else {
      const criteriaEntry = locationCriteria?.find(
        (c: any) =>
          c.name === locationKey ||
          c.displayName === locationKey ||
          c.name === locationKey.toLowerCase() ||
          c.displayName?.toLowerCase() === locationKey.toLowerCase()
      );

      const lat = criteriaEntry?.centerLat;
      const lng = criteriaEntry?.centerLng;
      const criteriaId = criteriaEntry?.id;
      const radiusKm = criteriaEntry?.radius ?? 5; // default radius if not provided by backend

      const navigationParams = {
        location: locationKey,
        locationName,
        criteriaId,
        lat,
        lng,
        radiusKm,
        filterByLocationCriteria: true
      };

      // Navigate to the LocationSearchScreen with strict location filter params
      (navigation as any).navigate("LocationSearch", navigationParams);
    }
  };

  const handleScrollToTop = () => {
    if (scrollViewRef.current) {
      scrollViewRef.current.scrollTo({ y: 0, animated: true });
    } else {
      console.log("❌ AirbnbHomeDiscovery: ScrollView ref is null");
    }
  };

  const handleScroll = (event: any) => {
    const scrollY = event.nativeEvent.contentOffset.y;
    const isScrollingDown = scrollY > lastScrollY.current;
    const isScrollingUp = scrollY < lastScrollY.current;

    // Show button when scrolling down and past 100px
    if (isScrollingDown && scrollY > 100) {
      setShowScrollToTop(true);
      Animated.timing(buttonOpacity, {
        toValue: 1,
        duration: 200,
        useNativeDriver: true
      }).start();
    }
    // Hide button when scrolling up or near the top
    else if (isScrollingUp && scrollY < 50) {
      Animated.timing(buttonOpacity, {
        toValue: 0,
        duration: 200,
        useNativeDriver: true
      }).start(() => {
        setShowScrollToTop(false);
      });
    }

    lastScrollY.current = scrollY;
  };

  const categories = [
    { key: "homes", label: "Homes", icon: "home", color: "#00A699" },
    {
      key: "experiences",
      label: "Experiences",
      icon: "flight",
      color: "#FF5A5F",
      isNew: true
    },
    {
      key: "services",
      label: "Services",
      icon: "notifications",
      color: "#C0C0C0",
      isNew: true
    }
  ];

  // Generate location sections from server data, only include sections with properties
  const locationSections =
    locationCriteria
      ?.map((criteria: any) => ({
        title: criteria.displayName,
        locationKey: criteria.name,
        locationName: criteria.displayName,
        criteriaId: criteria.id,
        description: criteria.description,
        icon: criteria.icon,
        color: criteria.color,
        propertyCount: criteria.propertyCount
      }))
      .filter((section: any) => section.propertyCount > 0) || [];
  const { t } = useTranslation();

  // Get all criteria IDs
  const criteriaIds = useMemo(
    () => locationSections.map((section: any) => section.criteriaId),
    [locationSections]
  );

  // Fetch all properties from all location criteria at once (using langParam from above)
  const {
    data: allLocationData,
    isLoading: propertiesLoading,
    error: propertiesError
  } = useMultipleLocationProperties(
    criteriaIds.length > 0 ? criteriaIds : [],
    50,
    langParam
  );

  // Combine all properties with their location criteria info
  const allProperties = useMemo(() => {
    const combined: Array<{ property: any; locationCriteria: any }> = [];

    if (allLocationData && locationSections.length > 0) {
      allLocationData.forEach((locationData: any, index: number) => {
        const section = locationSections[index];
        if (section && locationData?.properties) {
          locationData.properties.forEach((property: any) => {
            combined.push({
              property,
              locationCriteria: {
                displayName: section.locationName,
                locationKey: section.locationKey,
                criteriaId: section.criteriaId
              }
            });
          });
        }
      });
    }

    return combined;
  }, [allLocationData, locationSections]);

  const isLoading = criteriaLoading || propertiesLoading;
  const hasError = criteriaError || propertiesError;

  return (
    <View style={styles.container}>
      <StatusBar barStyle="dark-content" backgroundColor="#FFFFFF" />

      {/* Content */}
      <ScrollView
        ref={scrollViewRef}
        style={styles.content}
        showsVerticalScrollIndicator={false}
        onScroll={handleScroll}
        scrollEventThrottle={16}
        contentContainerStyle={styles.verticalScrollContent}
      >
        {isLoading ? (
          <View style={styles.loadingContainer}>
            <Text style={styles.loadingText}>Loading properties...</Text>
          </View>
        ) : hasError ? (
          <View style={styles.errorContainer}>
            <Text style={styles.errorText}>
              Unable to load properties. Please try again later.
            </Text>
          </View>
        ) : allProperties.length > 0 ? (
          <View style={styles.twoColumnContainer}>
            {allProperties.map((item, index) => (
              <React.Fragment
                key={`${item.property.id || item.property.ID}-${
                  item.locationCriteria.criteriaId
                }`}
              >
                <PropertyCard
                  property={item.property}
                  locationCriteria={item.locationCriteria}
                  delay={index * 50}
                  onToast={showToastMessage}
                />
                {index === 3 && (
                  <View style={styles.fullWidthPromo}>
                    <AddFreePromo
                      onPress={() =>
                        (navigation as any).navigate("AddListingGuide")
                      }
                    />
                  </View>
                )}
              </React.Fragment>
            ))}
          </View>
        ) : (
          <View style={styles.errorContainer}>
            <Text style={styles.errorText}>No properties found.</Text>
          </View>
        )}
      </ScrollView>

      {/* Scroll to Top Button */}
      {showScrollToTop && (
        <Animated.View
          style={[styles.scrollToTopContainer, { opacity: buttonOpacity }]}
        >
          <TouchableOpacity
            style={styles.scrollToTopButton}
            onPress={() => {
              handleScrollToTop();
            }}
            activeOpacity={0.8}
          >
            <MaterialIcons
              name="keyboard-arrow-up"
              size={20}
              color={theme["color-temporary-primary"]}
            />
          </TouchableOpacity>
        </Animated.View>
      )}
      {showToast && (
        <CustomToast
          message={toastMessage}
          type={toastType}
          duration={3000}
          onHide={() => setShowToast(false)}
        />
      )}
    </View>
  );
};
