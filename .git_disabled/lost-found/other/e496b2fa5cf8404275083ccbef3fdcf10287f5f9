import React, { useState, useRef, useCallback, useEffect } from "react";
import {
  View,
  Text,
  Image,
  TouchableOpacity,
  StyleSheet,
  Dimensions,
  ScrollView,
  Modal,
  Pressable,
  Animated,
  Platform
} from "react-native";
import { MaterialIcons } from "@expo/vector-icons";
import { useTranslation } from "react-i18next";
import { Video, ResizeMode, AVPlaybackStatus } from "expo-av";

interface PropertyData {
  id: number;
  title: string;
  listing_price?: number;
  price?: number;
  images?: string[];
  bedrooms?: number;
  bathrooms?: number;
  square_footage?: number;
  area?: number;
  address?: string;
  city?: string;
  state?: string;
  country?: string;
  year_built?: number;
  property_type?: string;
  organization?: {
    name?: string;
    banner_image?: string;
    phone?: string;
    website?: string;
  };
  amenities?: string[];
  status?: string;
  days_on_market?: number;
  video_url?: string;
  videoUrl?: string;
  video?: string;
  videos?: string[];
}

interface ZillowStylePropertyCardProps {
  property: PropertyData;
  onPress: (id: number) => void;
  onCall?: (phone?: string) => void;
  onEmail?: (website?: string) => void;
  onFavorite?: (id: number) => void;
  isFavorite?: boolean;
}

const { width: screenWidth } = Dimensions.get("window");
const CARD_WIDTH = screenWidth - 32;
const IMAGE_HEIGHT = 140;

const ImageSkeleton: React.FC<{ width: number; height: number }> = ({
  width,
  height
}) => {
  const shimmerAnimation = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    // DISABLE SHIMMER ANIMATION ON ANDROID to prevent crashes and improve performance
    if (Platform.OS === 'android') {
      // On Android, no shimmer animation - just static skeleton
      shimmerAnimation.setValue(0);
      return;
    }

    // iOS: Shimmer animation
    const shimmer = Animated.loop(
      Animated.timing(shimmerAnimation, {
        toValue: 1,
        duration: 1500,
        useNativeDriver: true
      })
    );
    shimmer.start();
    return () => shimmer.stop();
  }, [shimmerAnimation]);

  // On Android, don't use animated shimmer - just return static view
  if (Platform.OS === 'android') {
    return (
      <View style={[styles.skeletonContainer, { width, height }]}>
        <View style={[styles.skeletonShimmer, { width, height, opacity: 0.3 }]} />
      </View>
    );
  }

  const translateX = shimmerAnimation.interpolate({
    inputRange: [0, 1],
    outputRange: [-width * 2, width * 2]
  });

  return (
    <View style={[styles.skeletonContainer, { width, height }]}>
      <Animated.View
        style={[
          styles.skeletonShimmer,
          {
            width: width * 0.4,
            height,
            transform: [{ translateX }]
          }
        ]}
      />
    </View>
  );
};

export const ZillowStylePropertyCard: React.FC<
  ZillowStylePropertyCardProps
> = ({
  property,
  onPress,
  onCall,
  onEmail,
  onFavorite,
  isFavorite = false
}) => {
  const { t } = useTranslation();
  const [imageIndex, setImageIndex] = useState(0);
  const [loadingImages, setLoadingImages] = useState<{
    [key: number]: boolean;
  }>({});
  const [videoModalVisible, setVideoModalVisible] = useState(false);
  const [isPlaying, setIsPlaying] = useState(true);
  const [videoStatus, setVideoStatus] = useState<AVPlaybackStatus | null>(null);

  const videoPreviewRef = useRef<Video>(null);
  const modalVideoRef = useRef<Video>(null);
  const initializedPropertyId = useRef<number | undefined>(undefined);

  const propertyTitle = property.title || "";
  const images = (property.images || []).filter(
    (img: string) => img && typeof img === "string" && img.trim().length > 0
  );
  const price = property.listing_price || property.price || 0;
  const area = property.square_footage || property.area || 0;

  useEffect(() => {
    if (initializedPropertyId.current !== property.id) {
      initializedPropertyId.current = property.id;

      if (images.length > 0) {
        const initialLoading: { [key: number]: boolean } = {};
        images.forEach((_, index) => {
          initialLoading[index] = true;
        });
        setLoadingImages(initialLoading);

        const timeoutId = setTimeout(() => {
          setLoadingImages({});
        }, 5000);

        return () => clearTimeout(timeoutId);
      }
    }
  }, [property.id, images]);

  const videoUrl =
    property.video_url ||
    property.videoUrl ||
    property.video ||
    (Array.isArray(property.videos) && property.videos.length > 0
      ? property.videos[0]
      : null);

  const formatPrice = (amount: number) => {
    return `${amount.toLocaleString()} `;
  };

  const handleImageScroll = (event: any) => {
    const contentOffset = event.nativeEvent.contentOffset.x;
    const index = Math.round(contentOffset / CARD_WIDTH);
    setImageIndex(index);
  };

  const getLocation = () => {
    return (
      property.address ||
      [property.city, property.state, property.country]
        .filter(Boolean)
        .join(", ")
    );
  };

  const getPropertySpecs = () => {
    const specs = [];
    if (property.bedrooms)
      specs.push(`${property.bedrooms}${t("propertyCard.bedrooms", "bd")}`);
    if (property.bathrooms)
      specs.push(`${property.bathrooms}${t("propertyCard.bathrooms", "ba")}`);
    if (area > 0) specs.push(`${area}sqm`);
    return specs.join(" • ");
  };

  const openVideoModal = useCallback(() => {
    setVideoModalVisible(true);
    setIsPlaying(true);
  }, []);

  const closeVideoModal = useCallback(() => {
    setVideoModalVisible(false);
    modalVideoRef.current?.pauseAsync();
  }, []);

  const togglePlayPause = useCallback(async () => {
    if (modalVideoRef.current) {
      if (isPlaying) {
        await modalVideoRef.current.pauseAsync();
      } else {
        await modalVideoRef.current.playAsync();
      }
      setIsPlaying(!isPlaying);
    }
  }, [isPlaying]);

  const handleVideoStatusUpdate = (status: AVPlaybackStatus) => {
    setVideoStatus(status);
    if (status.isLoaded) {
      setIsPlaying(status.isPlaying);
    }
  };

  const seekVideo = useCallback(
    async (direction: "forward" | "backward") => {
      if (modalVideoRef.current && videoStatus?.isLoaded) {
        const currentPosition = videoStatus.positionMillis || 0;
        const seekAmount = 10000;
        const newPosition =
          direction === "forward"
            ? currentPosition + seekAmount
            : Math.max(0, currentPosition - seekAmount);
        await modalVideoRef.current.setPositionAsync(newPosition);
      }
    },
    [videoStatus]
  );

  const formatTime = (millis: number) => {
    const totalSeconds = Math.floor(millis / 1000);
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;
    return `${minutes}:${seconds.toString().padStart(2, "0")}`;
  };

  return (
    <TouchableOpacity
      style={styles.card}
      onPress={() => onPress(property.id)}
      activeOpacity={0.8}
    >
      {/* Image Section */}
      <View style={styles.imageContainer}>
        {images.length > 0 ? (
          <>
            <ScrollView
              horizontal
              pagingEnabled
              showsHorizontalScrollIndicator={false}
              onMomentumScrollEnd={handleImageScroll}
              scrollEventThrottle={16}
              decelerationRate="fast"
              snapToInterval={CARD_WIDTH}
              snapToAlignment="start"
              contentContainerStyle={{ width: CARD_WIDTH * images.length }}
              nestedScrollEnabled={Platform.OS === "android"}
            >
              {images.map((image, index) => {
                const isLoading = loadingImages[index] === true;
                return (
                  <View
                    key={index}
                    style={[styles.imageWrapper, { width: CARD_WIDTH }]}
                  >
                    {isLoading && (
                      <ImageSkeleton width={CARD_WIDTH} height={IMAGE_HEIGHT} />
                    )}
                    <Image
                      source={{ uri: image }}
                      style={[styles.propertyImage, { width: CARD_WIDTH }]}
                      resizeMode="cover"
                      onLoadStart={() => {
                        setLoadingImages((prev) => {
                          if (prev[index] !== false) {
                            return { ...prev, [index]: true };
                          }
                          return prev;
                        });
                      }}
                      onLoad={() => {
                        setLoadingImages((prev) => ({
                          ...prev,
                          [index]: false
                        }));
                      }}
                      onLoadEnd={() => {
                        setLoadingImages((prev) => ({
                          ...prev,
                          [index]: false
                        }));
                      }}
                      onError={() => {
                        setLoadingImages((prev) => ({
                          ...prev,
                          [index]: false
                        }));
                      }}
                    />
                  </View>
                );
              })}
            </ScrollView>

            {/* Favorite Button */}
            {onFavorite && (
              <TouchableOpacity
                style={styles.favoriteButton}
                onPress={() => onFavorite(property.id)}
              >
                <MaterialIcons
                  name={isFavorite ? "favorite" : "favorite-border"}
                  size={18}
                  color={isFavorite ? "#FF6B9D" : "#FFFFFF"}
                />
              </TouchableOpacity>
            )}

            {/* Image Indicators */}
            {images.length > 1 && (
              <View style={styles.indicators}>
                {images.slice(0, 3).map((_, i) => (
                  <View
                    key={i}
                    style={[styles.dot, i === imageIndex && styles.activeDot]}
                  />
                ))}
              </View>
            )}

            {/* Video Preview */}
            {videoUrl && (
              <TouchableOpacity
                style={styles.videoThumbnail}
                onPress={openVideoModal}
              >
                <Video
                  ref={videoPreviewRef}
                  source={{ uri: videoUrl }}
                  style={styles.videoPreview}
                  resizeMode={ResizeMode.COVER}
                  shouldPlay={true}
                  isLooping={true}
                  isMuted={true}
                />
                <View style={styles.videoOverlay} />
                <MaterialIcons name="play-arrow" size={20} color="#FFF" />
              </TouchableOpacity>
            )}
          </>
        ) : (
          <View style={styles.placeholderImage}>
            <MaterialIcons name="home" size={32} color="#CBD5E1" />
          </View>
        )}
      </View>

      {/* Content */}
      <View style={styles.content}>
        {/* Title & Price Row */}
        <View style={styles.headerRow}>
          <View style={styles.titleSection}>
            <Text style={styles.title} numberOfLines={1}>
              {propertyTitle}
            </Text>
            <Text style={styles.specs}>{getPropertySpecs()}</Text>
          </View>
          <Text style={styles.price}>{formatPrice(price)} MRU</Text>
        </View>

        {/* Location */}
        <View style={styles.locationRow}>
          <MaterialIcons name="location-on" size={12} color="#94A3B8" />
          <Text style={styles.location}>{getLocation()}</Text>
        </View>

        {/* Footer Actions */}
        <View style={styles.footer}>
          <View>
            {property.organization?.name && (
              <Text style={styles.agencyName} numberOfLines={1}>
                {property.organization.name}
              </Text>
            )}
          </View>

          <View style={styles.actionRow}>
            {onCall && property.organization?.phone && (
              <TouchableOpacity
                style={styles.callBtn}
                onPress={() => onCall(property.organization?.phone)}
              >
                <MaterialIcons name="phone" size={14} color="#FFF" />
              </TouchableOpacity>
            )}

            {onEmail && property.organization?.website && (
              <TouchableOpacity
                style={styles.emailBtn}
                onPress={() => onEmail(property.organization?.website)}
              >
                <MaterialIcons name="mail" size={14} color="#0066CC" />
              </TouchableOpacity>
            )}
          </View>
        </View>
      </View>

      {/* Video Modal */}
      <Modal
        visible={videoModalVisible}
        transparent={true}
        animationType="fade"
        onRequestClose={closeVideoModal}
        statusBarTranslucent
      >
        <View style={styles.modalOverlay}>
          <Pressable style={styles.backdrop} onPress={closeVideoModal} />

          <View style={styles.modalContent}>
            <TouchableOpacity style={styles.closeBtn} onPress={closeVideoModal}>
              <MaterialIcons name="close" size={20} color="#FFF" />
            </TouchableOpacity>

            <Video
              ref={modalVideoRef}
              source={{ uri: videoUrl || "" }}
              style={styles.modalVideo}
              resizeMode={ResizeMode.CONTAIN}
              shouldPlay={true}
              isLooping={false}
              onPlaybackStatusUpdate={handleVideoStatusUpdate}
            />

            <View style={styles.controls}>
              {videoStatus?.isLoaded && (
                <View style={styles.progressSection}>
                  <Text style={styles.time}>
                    {formatTime(videoStatus.positionMillis || 0)}
                  </Text>
                  <View style={styles.progressBar}>
                    <View
                      style={[
                        styles.progress,
                        {
                          width: `${
                            ((videoStatus.positionMillis || 0) /
                              (videoStatus.durationMillis || 1)) *
                            100
                          }%`
                        }
                      ]}
                    />
                  </View>
                  <Text style={styles.time}>
                    {formatTime(videoStatus.durationMillis || 0)}
                  </Text>
                </View>
              )}

              <View style={styles.playerControls}>
                <TouchableOpacity onPress={() => seekVideo("backward")}>
                  <MaterialIcons name="replay-10" size={24} color="#FFF" />
                </TouchableOpacity>

                <TouchableOpacity
                  style={styles.playBtn}
                  onPress={togglePlayPause}
                >
                  <MaterialIcons
                    name={isPlaying ? "pause" : "play-arrow"}
                    size={28}
                    color="#FFF"
                  />
                </TouchableOpacity>

                <TouchableOpacity onPress={() => seekVideo("forward")}>
                  <MaterialIcons name="forward-10" size={24} color="#FFF" />
                </TouchableOpacity>
              </View>
            </View>

            <Text style={styles.modalTitle}>{propertyTitle}</Text>
          </View>
        </View>
      </Modal>
    </TouchableOpacity>
  );
};

