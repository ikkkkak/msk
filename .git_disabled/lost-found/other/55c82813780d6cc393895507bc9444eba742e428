    {/* Floating Action Button - Only show in Host Mode */}
    {isHostMode && (
      <FloatingActionButton
        actions={[
          {
            title: t('fab.addPropertyForRent', 'Add Property for Rent'),
            icon: <House size={24} color="#FFFFFF" weight="fill" />,
            onPress: () => {
              (navigation as any).navigate('AddProperty');
            },
            color: '#00A699',
          },
          {
            title: t('fab.addPropertyForSale', 'Add Property for Sale'),
            icon: <ShoppingBag size={24} color="#FFFFFF" weight="fill" />,
            onPress: () => {
              (navigation as any).navigate('CreatePropertySale');
            },
            color: '#FF385C',
          },
          {
            title: t('fab.addLandForRent', 'Add Land for Rent'),
            icon: <MapPin size={24} color="#FFFFFF" weight="fill" />,
            onPress: () => {
              (navigation as any).navigate('CreateLandmark');
            },
            color: '#9146FF',
          },
        ]}
        position={{ bottom: 10, right: 10 }}
        size={56}
        backgroundColor="#FFFF"
      />
    )}

    {/* Add Story Modal */}
    <AddStoryModal
      visible={storyModalVisible}
      onClose={() => setStoryModalVisible(false)}
      onUploaded={() => {
        // refresh inbox after upload
        (async () => {
          try {
            const res = await axios.get(`${endpoints.baseURL}/stories/inbox`);
            const list = (res.data?.inbox || []).map((it: any) => ({
              userId: it.user_id,
              username: it.username,
              avatarURL: it.avatar_url,
              hasUnseen: !!it.has_unseen,
              firstThumb: it.first_thumb,
            })) as StoryInboxItem[];
            setStoriesInbox(list);
          } catch {}
        })();
        
        // Check if user now has stories (to update icon from + to Eye)
        (async () => {
          if (user?.ID) {
            try {
              const res = await axios.get(`${endpoints.baseURL}/stories/${user.ID}`);
              const stories = res.data?.stories || [];
              setHasUserStories(stories.length > 0);
            } catch {}
          }
        })();
      }}

    />

  
    </>
  );
};

