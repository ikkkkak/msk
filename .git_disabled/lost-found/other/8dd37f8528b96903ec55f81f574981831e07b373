// Comment Item Component - Smooth Continuous Horizontal Wheel (Translation Only)
const CommentItem: React.FC<{
  comment: any;
  startX: number;
  duration: number;
  containerWidth: number;
}> = ({ comment, startX, duration, containerWidth }) => {
  // Pure horizontal translation animation - no opacity, no scaling, no popping
  const translateX = useSharedValue(startX);

  useEffect(() => {
    // Continuous horizontal movement - from right edge to left edge
    // startX is the starting position (containerWidth = right edge)
    // End at negative value to fully exit left of container
    const endX = -(containerWidth + 100); // Slide completely off left of container

    // Linear animation for constant speed (horizontal conveyor belt effect)
    translateX.value = withTiming(endX, {
      duration: duration, // Duration in ms for smooth constant speed
      easing: RNEasing.linear // Linear for constant speed - no easing curves
    });
  }, [startX, duration, containerWidth]);

  // Pure horizontal translation - GPU-accelerated transform only
  const animatedStyle = useAnimatedStyle(() => ({
    transform: [{ translateX: translateX.value }]
    // No opacity changes - pure translation only
  }));

  const formatTime = (dateString: string) => {
    const date = new Date(dateString);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) return "now";
    if (diffMins < 60) return `${diffMins}m`;
    if (diffHours < 24) return `${diffHours}h`;
    if (diffDays < 7) return `${diffDays}d`;
    return date.toLocaleDateString();
  };

  const userName =
    (comment.user as any)?.name || comment.user?.email || "Anonymous";

  return (
    <Reanimated.View
      style={[
        styles.commentCardHorizontal,
        animatedStyle,
        { position: "absolute", top: 0 }
      ]}
    >
      <Text style={styles.commentTextHorizontal} numberOfLines={2}>
        {comment.content}
      </Text>
    </Reanimated.View>
  );
};

