    const alreadySaved = isVideoSaved(stableId, item);
    const current = item.savesCount ?? savesCount[stableId] ?? 0; // Ensure we have a valid number
    const newCount = alreadySaved ? Math.max(0, current - 1) : current + 1;
    const newSavedState = !alreadySaved;

    // Optimistic update - update local state immediately
    setSaved((m) => ({ ...m, [stableId]: newSavedState }));
    setSavesCount((m) => ({ ...m, [stableId]: newCount }));
