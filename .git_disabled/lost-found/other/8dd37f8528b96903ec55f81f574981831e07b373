const VideoSkeleton = () => {
  const shimmerAnimation = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    const shimmer = Animated.loop(
      Animated.sequence([
        Animated.timing(shimmerAnimation, {
          toValue: 1,
          duration: 1000,
          useNativeDriver: true
        }),
        Animated.timing(shimmerAnimation, {
          toValue: 0,
          duration: 1000,
          useNativeDriver: true
        })
      ])
    );
    shimmer.start();
    return () => shimmer.stop();
  }, []);

  const shimmerStyle = {
    opacity: shimmerAnimation.interpolate({
      inputRange: [0, 1],
      outputRange: [0.3, 0.7]
    })
  };

  return (
    <View style={styles.skeletonContainer}>
      {/* Video Skeleton */}
      <Animated.View style={[styles.skeletonVideo, shimmerStyle]} />

      {/* Content Skeleton */}
      <View style={styles.skeletonContent}>
        <View style={styles.skeletonHeader}>
          <Animated.View style={[styles.skeletonAvatar, shimmerStyle]} />
          <View style={styles.skeletonTextContainer}>
            <Animated.View
              style={[styles.skeletonText, styles.skeletonTitle, shimmerStyle]}
            />
            <Animated.View
              style={[
                styles.skeletonText,
                styles.skeletonSubtitle,
                shimmerStyle
              ]}
            />
          </View>
        </View>

        <View style={styles.skeletonActions}>
          <Animated.View style={[styles.skeletonActionButton, shimmerStyle]} />
          <Animated.View style={[styles.skeletonActionButton, shimmerStyle]} />
          <Animated.View style={[styles.skeletonActionButton, shimmerStyle]} />
        </View>
      </View>
    </View>
  );
};

