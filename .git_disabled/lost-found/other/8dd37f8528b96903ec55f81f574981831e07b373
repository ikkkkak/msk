        setLikesCount((m) => ({ ...m, [stableId]: prevCount }));
        setToast({
          message: t("video.loginToLike", "Please sign in to like videos"),
          type: "info"
        });
      } finally {
        setLikePending((p) => ({ ...p, [stableId]: false }));
      }
