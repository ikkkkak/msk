    useAnimatedStyle(() => {
      const p = prog.value;
      const angle =
        (particleAnglesRef.current[i] || 0) +
        ringRotation.value * 2 * Math.PI * 0.6;
      const r = PARTICLE_RADIUS * p;
      const tx = r * Math.cos(angle);
      const ty = r * Math.sin(angle);
      return {
        opacity: particleOpacity[i].value,
