  // Skia heart animation values (central overlay like X)
  const heartScale = useSharedValue(0);
  const heartOpacity = useSharedValue(0);
  const PARTICLE_COUNT = 12;
  const particleProgress = Array.from({ length: PARTICLE_COUNT }, () =>
    useSharedValue(0)
  );
  const particleOpacity = Array.from({ length: PARTICLE_COUNT }, () =>
    useSharedValue(0)
  );
  const ringRotation = useSharedValue(0);
  const particleAnglesRef = useRef<number[]>(
    Array.from({ length: PARTICLE_COUNT }, (_, i) => {
      const base = (2 * Math.PI * i) / PARTICLE_COUNT;
      const jitter = (Math.random() - 0.5) * (Math.PI / 12);
      return base + jitter;
    })
  );
  const particleColorsRef = useRef<string[]>(
    Array.from({ length: PARTICLE_COUNT }, () => {
      const palette = [
        "#FF385C",
        "#FFC107",
        "#22C55E",
        "#3B82F6",
        "#A855F7",
        "#F97316",
        "#10B981"
      ];
      return palette[Math.floor(Math.random() * palette.length)];
    })
  );
  const particleSizesRef = useRef<number[]>(
    Array.from(
      { length: PARTICLE_COUNT },
      () => 4 + Math.round(Math.random() * 3)
    )
  );
  const triggerHeartBurst = useCallback(() => {
    heartScale.value = 0;
    heartOpacity.value = 1;
    // Scale up quickly, keep visible a bit longer, then fade
    heartScale.value = withTiming(
      1,
      { duration: 320, easing: RNEasing.out(RNEasing.cubic) },
      () => {
        heartOpacity.value = withDelay(
          450,
          withTiming(0, { duration: 380, easing: RNEasing.in(RNEasing.quad) })
        );
      }
    );

    // Particles to ring
    ringRotation.value = 0;
    ringRotation.value = withTiming(1, {
      duration: 900,
      easing: RNEasing.out(RNEasing.cubic)
    });
    particleAnglesRef.current.forEach((_, idx) => {
      particleOpacity[idx].value = 1;
      particleProgress[idx].value = 0;
      // slightly larger stagger for nicer spread
      const delay = 25 * idx;
      setTimeout(() => {
        particleProgress[idx].value = withTiming(1, {
          duration: 700,
          easing: RNEasing.out(RNEasing.cubic)
        });
        // fade after a short hold
        setTimeout(() => {
          particleOpacity[idx].value = withTiming(0, {
            duration: 500,
            easing: RNEasing.in(RNEasing.quad)
          });
        }, 400);
      }, delay);
    });
  }, [heartScale, heartOpacity]);

