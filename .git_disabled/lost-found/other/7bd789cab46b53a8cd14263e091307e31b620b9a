// ============================================================================
// MAIN MAP COMPONENT
// ============================================================================
export const MapPropertySale = ({
  properties = [],
  mapRef,
  initialRegion,
  onPropertySelect,
  selectedPropertyId,
  mapType: mapTypeProp = "standard",
  districtBoundaries = [],
  onPolygonApply,
  sheetRef,
  cardVisible = false,
  onDismissCard,
  navigation
}: {
  properties?: any[];
  mapRef?: any;
  initialRegion?: Region;
  onPropertySelect?: (propertyId: number, propertyData: any) => void;
  selectedPropertyId?: number | null;
  mapType?: "standard" | "satellite";
  districtBoundaries?: any[];
  onPolygonApply?: (polygon: any) => void;
  sheetRef?: any;
  cardVisible?: boolean;
  onDismissCard?: () => void;
  navigation?: any;
}) => {
  const INITIAL_REGION = {
    latitude: 17.998258963165103,
    longitude: -15.984606726560688,
    latitudeDelta: 0.2,
    longitudeDelta: 0.2
  };

  const [region, setRegion] = useState(initialRegion || INITIAL_REGION);
  const [mapType, setMapType] = useState<"standard" | "satellite">(
    mapTypeProp === "standard" || mapTypeProp === "satellite"
      ? mapTypeProp
      : "standard"
  );
  const [zonesVisible, setZonesVisible] = useState(true);
  const [selectedIndex, setSelectedIndex] = useState<number>(-1);
  const [selectedProperty, setSelectedProperty] = useState<any>(null);
  const [isDrawing, setIsDrawing] = useState(false);
  const [drawingPath, setDrawingPath] = useState<any[]>([]);
  const [polygonPath, setPolygonPath] = useState<any[]>([]);
  // CRITICAL FOR ANDROID: Start with true on Android to ensure markers render immediately
  // On iOS, wait for onMapReady for better performance
  const [mapMounted, setMapMounted] = useState(Platform.OS === 'android'); // Android: render immediately, iOS: wait for onMapReady
  const markerPressedRef = useRef(false);
  const isAnimatingToMarkerRef = useRef(false);
  const lastMarkerPressRef = useRef<number>(0);

  const zoomValue = useSharedValue(
    region.latitudeDelta <= ZOOM_THRESHOLD ? 1 : 0
  );

  const markersData = useMemo(() => {
    const safeProperties = Array.isArray(properties) ? properties : [];
    return safeProperties
      .map((prop: any, idx: number) => {
        const lat = prop?.latitude ?? prop?.lat;
        const lng = prop?.longitude ?? prop?.lng;

        if (
          !lat ||
          !lng ||
          isNaN(Number(lat)) ||
          isNaN(Number(lng)) ||
          !prop?.id
        ) {
          return null;
        }

        return {
          id: prop.id,
          property: prop,
          index: idx,
          lat: Number(lat),
          lng: Number(lng)
        };
      })
      .filter((m): m is NonNullable<typeof m> => m !== null);
  }, [properties]);

  const handleRegionChange = useCallback(
    (newRegion: Region) => {
      setRegion(newRegion);
      const isZoomed = newRegion.latitudeDelta <= ZOOM_THRESHOLD;
      zoomValue.value = withTiming(isZoomed ? 1 : 0, {
        duration: 350,
        easing: EASING
      });
    },
    [zoomValue]
  );

  const handleMarkerPress = useCallback(
    (markerIndex: number) => {
      const marker = markersData[markerIndex];
      if (!marker || !marker.property) return;

      const prop = marker.property;

      if (!prop.id || prop.latitude === null || prop.longitude === null) {
        return;
      }

      // CRITICAL: Call onPropertySelect FIRST - INSTANT response, zero delays
      // This MUST happen before ANY other operations - matches Map.tsx behavior
      if (onPropertySelect) {
        onPropertySelect(prop.id, prop);
      }

      // All other operations happen AFTER - non-blocking (moved to requestAnimationFrame)
      requestAnimationFrame(() => {
        // Haptic feedback (non-blocking, async)
        Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium).catch(() => {});

        // PREVENT MAP PRESS FROM FIRING (non-blocking)
        markerPressedRef.current = true;
        lastMarkerPressRef.current = Date.now();
        setTimeout(() => {
          markerPressedRef.current = false;
        }, 300);

        // Set selected marker and property (non-blocking)
        setSelectedIndex(markerIndex);
        setSelectedProperty(prop);

        // Zoom map to marker location (NON-BLOCKING - happens in background)
        // Use requestAnimationFrame to match Map.tsx behavior exactly
        if (mapRef?.current?.animateToRegion) {
          isAnimatingToMarkerRef.current = true;
          mapRef.current.animateToRegion(
            {
              latitude: marker.lat,
              longitude: marker.lng,
              latitudeDelta: 0.075,
              longitudeDelta: 0.075
            },
            300
          );
          setTimeout(() => {
            isAnimatingToMarkerRef.current = false;
          }, 350);
        }
      });
    },
    [markersData, onPropertySelect, mapRef]
  );

  const handleMapPress = useCallback(() => {
    // Ignore map presses while animating to a marker
    if (isAnimatingToMarkerRef.current) return;

    // Ignore presses that happen very shortly after a marker press (debounce)
    if (Date.now() - (lastMarkerPressRef.current || 0) < 500) return;

    if (!isDrawing && !markerPressedRef.current) {
      // CRITICAL: Only deselect marker if card is NOT visible
      // If card is visible, just dismiss the card but keep marker selected
      if (!cardVisible) {
        setSelectedIndex(-1);
        setSelectedProperty(null);
      }

      // Show bottom tabs when map is pressed
      if (navigation) {
        navigation.getParent()?.setOptions({
          tabBarStyle: { display: "flex" }
        });
      }

      // If a property card is visible, dismiss it instead of restoring sheet
      if (cardVisible) {
        console.log(
          "🗂️ MapPropertySale: map press while cardVisible — calling onDismissCard"
        );
        if (onDismissCard) {
          onDismissCard();
        }
        return;
      }

      // Restore sheet to default state (index 1 = 40%)
      if (sheetRef?.current) {
        sheetRef.current.snapToIndex(1);
      }
    }
  }, [isDrawing, navigation, sheetRef, cardVisible, onDismissCard]);

  const handleMapDrag = useCallback(() => {
    // Don't deselect if we're animating to a marker (programmatic movement)
    if (isAnimatingToMarkerRef.current) {
      return;
    }

    // CRITICAL: Don't deselect marker when dragging map if card is visible
    // User might be dragging to see the map better while viewing card
    if (!isDrawing && selectedIndex !== -1 && !cardVisible) {
      setSelectedIndex(-1);
      setSelectedProperty(null);

      // Show bottom tabs when map is dragged
      if (navigation) {
        navigation.getParent()?.setOptions({
          tabBarStyle: { display: "flex" }
        });
      }

      // If a property card is visible, dismiss it instead of restoring sheet
      if (cardVisible) {
        if (onDismissCard) {
          onDismissCard();
        }
        return;
      }

      // Restore sheet to default state (index 1 = 40%)
      if (sheetRef?.current) {
        sheetRef.current.snapToIndex(1);
      }
    }
  }, [
    isDrawing,
    selectedIndex,
    navigation,
    sheetRef,
    cardVisible,
    onDismissCard
  ]);

  const handleDrawStart = () => {
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium).catch(() => {});
    setIsDrawing(!isDrawing);
    if (!isDrawing) {
      setDrawingPath([]);
      setPolygonPath([]);
    }
  };

  const handleMapTouch = useCallback(
    (e: any) => {
      if (!isDrawing) return;
      const coord = e?.nativeEvent?.coordinate;
      if (!coord) return;

      setDrawingPath((prev) => {
        if (prev.length === 0) return [coord];
        const last = prev[prev.length - 1];
        const dist = Math.sqrt(
          Math.pow(coord.latitude - last.latitude, 2) +
            Math.pow(coord.longitude - last.longitude, 2)
        );
        return dist > 0.000005 ? [...prev, coord] : prev;
      });
    },
    [isDrawing]
  );

  const handleUndo = () => {
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light).catch(() => {});
    setDrawingPath((prev) => (prev.length > 0 ? prev.slice(0, -1) : prev));
  };

  const handleClear = () => {
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light).catch(() => {});
    setDrawingPath([]);
    setPolygonPath([]);
  };

  const handleApply = () => {
    if (drawingPath.length < 3) {
      Haptics.notificationAsync(Haptics.NotificationFeedbackType.Error).catch(
        () => {}
      );
      return;
    }
    Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success).catch(
      () => {}
    );
    const closed = [...drawingPath, drawingPath[0]];
    setPolygonPath(closed);
    setDrawingPath([]);
    onPolygonApply?.(closed);
  };

  // CRITICAL FOR ANDROID: Ensure markers are visible on initial load
  useEffect(() => {
    // Mark map as mounted after a brief delay to allow rendering
    const timer = setTimeout(() => {
      setMapMounted(true);
      console.log(
        "🗺️ Map mounted - markers should now be visible on all platforms"
      );
    }, 100);
    return () => clearTimeout(timer);
  }, []);

  useEffect(() => {
    if (mapTypeProp === "standard" || mapTypeProp === "satellite") {
      setMapType(mapTypeProp);
    }
  }, [mapTypeProp]);

  useEffect(() => {
    if (selectedPropertyId != null) {
      const idx = properties.findIndex((p) => p?.id === selectedPropertyId);
      if (idx >= 0) {
        setSelectedIndex(idx);
      }
    }
    // CRITICAL: Don't reset selectedIndex when selectedPropertyId becomes null
    // This keeps the marker selected even when card is dismissed
    // Marker will only deselect when user explicitly clicks map or another marker
  }, [selectedPropertyId, properties]);

  return (
    <View style={styles.mapRoot}>
      <MapView
        ref={mapRef}
        style={styles.mapView}
        initialRegion={initialRegion || INITIAL_REGION}
        mapType={mapType || "standard"}
        userInterfaceStyle="light"
        onRegionChangeComplete={handleRegionChange}
        onRegionChange={handleMapDrag}
        scrollEnabled={!isDrawing}
        zoomEnabled={!isDrawing}
        pitchEnabled={false}
        rotateEnabled={false}
        onPress={handleMapPress}
        onTouchEnd={handleMapTouch}
        onMapReady={() => {
          // CRITICAL FOR ANDROID: Force markers to render after map is ready
          setMapMounted(true);
          console.log(
            "✅ MapView onMapReady fired - markers rendering on Android"
          );
        }}
      >
        {districtBoundaries?.map((district, idx) => {
          const coords = district?.coordinates || [];
          const len = coords.length;
          const centerLat =
            len > 0
              ? coords.reduce((s: number, c: any) => s + c.latitude, 0) / len
              : 0;
          const centerLng =
            len > 0
              ? coords.reduce((s: number, c: any) => s + c.longitude, 0) / len
              : 0;

          return (
            <React.Fragment key={`district-${idx}`}>
              <Polygon
                coordinates={coords}
                strokeColor={zonesVisible ? "#D1D5DB" : "transparent"}
                fillColor={
                  zonesVisible ? "rgba(229, 231, 235, 0.06)" : "transparent"
                }
                strokeWidth={zonesVisible ? 1.5 : 0}
                lineJoin="round"
              />
              {zonesVisible && district?.name && (
                <Marker
                  coordinate={{ latitude: centerLat, longitude: centerLng }}
                  anchor={{ x: 0.5, y: 0.5 }}
                  tracksViewChanges={false}
                >
                  <Text style={styles.districtName}>{district.name}</Text>
                </Marker>
              )}
            </React.Fragment>
          );
        })}

        {isDrawing && drawingPath.length > 1 && (
          <Polyline
            coordinates={drawingPath}
            strokeColor="#10B981"
            strokeWidth={2.5}
            lineCap="round"
            lineJoin="round"
            geodesic
          />
        )}

        {polygonPath.length >= 3 && !isDrawing && (
          <Polygon
            coordinates={polygonPath}
            strokeColor="#10B981"
            fillColor="rgba(16, 185, 129, 0.12)"
            strokeWidth={2}
            lineJoin="round"
          />
        )}

        {Array.isArray(markersData) &&
          markersData.length > 0 &&
          mapMounted && // CRITICAL: Only render markers after map is mounted
          markersData.map((marker) => {
            if (
              !marker ||
              !marker.id ||
              !marker.lat ||
              !marker.lng ||
              isNaN(marker.lat) ||
              isNaN(marker.lng)
            ) {
              return null;
            }

            const isSelected = selectedIndex === marker.index;

            return (
              <Marker
                key={`marker-${marker.id}-${
                  isSelected ? "selected" : "normal"
                }`}
                coordinate={{ latitude: marker.lat, longitude: marker.lng }}
                anchor={MARKER_ANCHOR}
                tracksViewChanges={Platform.OS !== 'android'} // CRITICAL: Disable on Android for better performance
                onPress={() => handleMarkerPress(marker.index)}
                zIndex={isSelected ? 999 : 100}
                stopPropagation
              >
                <ProfessionalMarker
                  property={marker.property}
                  isSelected={isSelected}
                  zoomValue={zoomValue}
                />
              </Marker>
            );
          })}
      </MapView>

      {/* <MapControls
        isDrawing={isDrawing}
        onDraw={handleDrawStart}
        mapType={mapType}
        onMapType={() =>
          setMapType((m) => (m === "satellite" ? "standard" : "satellite"))
        }
        zonesVisible={zonesVisible}
        onZones={() => setZonesVisible(!zonesVisible)}
        onUndo={handleUndo}
        onClear={handleClear}
        onApply={handleApply}
        canDraw={drawingPath.length > 0 || polygonPath.length > 0}
      /> */}
    </View>
  );
};

