// ============================================================================
// CONSTANTS
// ============================================================================
const ZOOM_THRESHOLD = 0.14;
const SCREEN_WIDTH = Dimensions.get("window").width;
const SCREEN_HEIGHT = Dimensions.get("window").height;

const DOT_SIZE = 14;
const MARKER_WIDTH = 90;
const MARKER_HEIGHT = 70;
const MARKER_IMG_HEIGHT = 37;
const ARROW_HEIGHT = 6;

// CRITICAL FOR ANDROID: Adjust anchor point for proper marker positioning
// Android needs slightly different anchor to prevent positioning issues
const MARKER_ANCHOR = Platform.OS === 'android' 
  ? { x: 0.5, y: 1.0 } // Android: Better positioning
  : { x: 0.5, y: 1.1 }; // iOS: Original anchor
const EASING = Easing.bezier(0.25, 0.46, 0.45, 0.94);

const MARKER_CONFIG = {
  DOT_SIZE: 12,
  DOT_INNER_SIZE: 7,
  CARD_WIDTH: 80,
  CARD_HEIGHT: 48,
  CARD_BORDER_RADIUS: 8,
  ZOOM_THRESHOLD: 0.12
};

// ============================================================================
// MINI MARKER CARD
// ============================================================================
const ProfessionalMarker = React.memo(
  ({
    property,
    isSelected,
    zoomValue,
    onImagePress
  }: {
    property: any;
    isSelected: boolean;
    zoomValue: any;
    onImagePress?: () => void;
  }) => {
    if (!property || !property.id) {
      return null;
    }

    const fullPrice = useMemo(() => {
      const price = property.listing_price ?? property.price ?? 0;
      const numPrice = Number(price);
      if (isNaN(numPrice) || numPrice < 0) return "0 MRU";
      return `${numPrice.toLocaleString("en-US", {
        maximumFractionDigits: 0
      })} MRU`;
    }, [property.listing_price, property.price]);

    const images: string[] = Array.isArray(property?.images)
      ? property.images.filter((u: any) => !!u)
      : [];
    const imageUrl = images[0] || null;
    const [imgIndex, setImgIndex] = useState(0);
    const flatRef = useRef<FlatList<string> | null>(null);

    // DISABLE ANIMATIONS ON ANDROID to prevent crashes
    const dotAnimStyle = useAnimatedStyle(() => {
      if (Platform.OS === 'android') {
        // On Android, show dot always visible with no animations
        return {
          opacity: 1,
          transform: [{ scale: 1 }]
        };
      }
      // iOS: Use smooth animations
      return {
        opacity: interpolate(
          zoomValue.value,
          [0, 0.35],
          [1, 0],
          Extrapolate.CLAMP
        ),
        transform: [
          {
            scale: interpolate(
              zoomValue.value,
              [0, 0.4],
              [1, 0.95],
              Extrapolate.CLAMP
            )
          }
        ]
      };
    });

    const cardAnimStyle = useAnimatedStyle(() => {
      if (Platform.OS === 'android') {
        // On Android, show card always visible with no animations
        const zoom = zoomValue.value;
        const shouldShow = zoom > 0.25;
        return {
          opacity: shouldShow ? 1 : 0,
          transform: [{ scale: 1 }]
        };
      }
      // iOS: Use smooth animations
      return {
        opacity: interpolate(
          zoomValue.value,
          [0.25, 0.5],
          [0, 1],
          Extrapolate.CLAMP
        ),
        transform: [
          {
            scale: interpolate(
              zoomValue.value,
              [0.2, 1],
              [0.8, 1],
              Extrapolate.CLAMP
            )
          }
        ]
      };
    });

    return (
      <View style={styles.markerRoot}>
        <Animated.View style={[styles.dotWrapper, dotAnimStyle]}>
          <View style={[styles.dotBase, isSelected && styles.dotBaseActive]} />
        </Animated.View>

        <Animated.View style={[styles.cardWrapper, cardAnimStyle]}>
          <View
            style={[styles.markerCard, isSelected && styles.markerCardSelected]}
          >
            <View style={styles.markerImage}>
              {images.length > 0 ? (
                <FlatList
                  ref={(r) => {
                    flatRef.current = r;
                  }}
                  data={images}
                  horizontal
                  pagingEnabled
                  showsHorizontalScrollIndicator={false}
                  keyExtractor={(it, i) => `mimg-${property.id}-${i}`}
                  onMomentumScrollEnd={(e) => {
                    const x = e.nativeEvent.contentOffset.x || 0;
                    const idx = Math.round(x / MARKER_CONFIG.CARD_WIDTH);
                    setImgIndex(idx);
                  }}
                  renderItem={({ item }) => (
                    <TouchableOpacity
                      activeOpacity={0.9}
                      onPress={() => onImagePress?.()}
                      style={{
                        width: MARKER_CONFIG.CARD_WIDTH,
                        height: "100%"
                      }}
                    >
                      <Image
                        source={{ uri: item }}
                        style={styles.imageFill}
                        resizeMode="cover"
                      />
                    </TouchableOpacity>
                  )}
                />
              ) : (
                <View style={styles.imagePlaceholder}>
                  <MaterialIcons name="home" size={18} color="#CBD5E1" />
                </View>
              )}
            </View>

            <View style={styles.priceSection}>
              <Text
                style={[styles.priceText, isSelected && styles.priceTextActive]}
                numberOfLines={2}
                ellipsizeMode="tail"
              >
                {fullPrice}
              </Text>
            </View>
          </View>

          <View style={styles.arrowWrapper}>
            <View
              style={[styles.arrowTip, isSelected && styles.arrowTipActive]}
            />
          </View>
        </Animated.View>
      </View>
    );
  },
  (prevProps, nextProps) => {
    return (
      prevProps.property?.id === nextProps.property?.id &&
      prevProps.isSelected === nextProps.isSelected
    );
  }
);

