import { useMutation, useQueryClient } from "react-query";
import axios from "axios";
import { useUser } from "../useUser";
import { queryKeys, endpoints } from "../../constants";

export const useLikePropertySaleVideoMutation = () => {
  const { user } = useUser();
  const queryClient = useQueryClient();

  return useMutation(
    async (videoID: number) => {
      if (!user?.accessToken) {
        throw new Error('Authentication required');
      }
      const response = await axios.post(
        `${endpoints.baseURL}/property-sale-videos/${videoID}/like`,
        {},
        {
          headers: { Authorization: `Bearer ${user.accessToken}` },
        }
      );
      return { videoID, likesCount: response.data?.likesCount, liked: true };
    },
    {
      // CRITICAL: Update query cache directly instead of invalidating to maintain feed stability
      onSuccess: (data) => {
        // Update cursor-based feed cache
        queryClient.setQueryData(['cursorVideoFeed', 'sale', user?.ID], (old: any) => {
          if (!old) return old;
          return {
            ...old,
            pages: old.pages.map((page: any) => ({
              ...page,
              videos: page.videos.map((v: any) => {
                // Handle both numeric IDs and string IDs like "123_0"
                const vStableId = typeof v.ID === 'string' 
                  ? parseInt(v.ID.split('_')[0], 10)
                  : Number(v.ID);
                if (vStableId === data.videoID) {
                  return { 
                    ...v, 
                    likesCount: data.likesCount ?? (v.likesCount ?? 0) + 1,
                    liked: true // CRITICAL: Set liked to true
                  };
                }
                return v;
              })
            }))
          };
        });
      },
    }
  );
};

